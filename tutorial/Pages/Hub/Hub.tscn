[gd_scene format=3]

[ext_resource type="Script" path="res://Pages/Hub/Hub.cs" id="1_hub"]
[ext_resource type="Script" path="res://Shell/Column.cs" id="2_column"]
[ext_resource type="Script" path="res://Shell/CardButton.cs" id="3_cardbutton"]
[ext_resource type="Script" path="res://Shell/Dot.cs" id="4_dot"]
[ext_resource type="Script" path="res://Pages/Hub/TutorialPath.cs" id="5_tutorialpath"]
[ext_resource type="PackedScene" path="res://Pages/Hub/StepRow.tscn" id="6_steprow"]
[ext_resource type="Script" path="res://Pages/Hub/SpeechBubble.cs" id="7_speechbubble"]
[ext_resource type="PackedScene" path="res://Pages/Hub/Ferret.tscn" id="8_ferret"]
[ext_resource type="PackedScene" path="res://Shell/LinkCard.tscn" id="9_linkcard"]

[node name="Hub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_hub")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 40

[node name="Column" type="Container" parent="Scroll/Margin"]
layout_mode = 2
script = ExtResource("2_column")

[node name="Content" type="VBoxContainer" parent="Scroll/Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Eyebrow" type="Label" parent="Scroll/Margin/Column/Content"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "LEARN"

[node name="Title" type="Label" parent="Scroll/Margin/Column/Content"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Tutorial"

[node name="Lead" type="Label" parent="Scroll/Margin/Column/Content"]
layout_mode = 2
theme_type_variation = &"LeadLabel"
text = "Learn tweens.gd in five short steps, in C# or GDScript."
autowrap_mode = 3

[node name="DoorsGap" type="Control" parent="Scroll/Margin/Column/Content"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
mouse_filter = 2

[node name="Doors" type="HBoxContainer" parent="Scroll/Margin/Column/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CSharpDoor" type="PanelContainer" parent="Scroll/Margin/Column/Content/Doors"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Door"
script = ExtResource("3_cardbutton")
Normal = &"Door"
Rise = 0.0

[node name="Row" type="HBoxContainer" parent="Scroll/Margin/Column/Content/Doors/CSharpDoor"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Copy" type="VBoxContainer" parent="Scroll/Margin/Column/Content/Doors/CSharpDoor/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="Scroll/Margin/Column/Content/Doors/CSharpDoor/Row/Copy"]
layout_mode = 2
theme_type_variation = &"DoorTitle"
text = "Start with C#"

[node name="Requirements" type="Label" parent="Scroll/Margin/Column/Content/Doors/CSharpDoor/Row/Copy"]
layout_mode = 2
theme_type_variation = &"DoorHint"
text = "Godot 4.7.2 .NET"

[node name="Check" type="Control" parent="Scroll/Margin/Column/Content/Doors/CSharpDoor/Row"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("4_dot")
MutedOutline = true

[node name="GDScriptDoor" type="PanelContainer" parent="Scroll/Margin/Column/Content/Doors"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Door"
script = ExtResource("3_cardbutton")
Normal = &"Door"
Rise = 0.0

[node name="Row" type="HBoxContainer" parent="Scroll/Margin/Column/Content/Doors/GDScriptDoor"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Copy" type="VBoxContainer" parent="Scroll/Margin/Column/Content/Doors/GDScriptDoor/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="Scroll/Margin/Column/Content/Doors/GDScriptDoor/Row/Copy"]
layout_mode = 2
theme_type_variation = &"DoorTitle"
text = "Start with GDScript"

[node name="Requirements" type="Label" parent="Scroll/Margin/Column/Content/Doors/GDScriptDoor/Row/Copy"]
layout_mode = 2
theme_type_variation = &"DoorHint"
text = "Godot 4.7.2"

[node name="Check" type="Control" parent="Scroll/Margin/Column/Content/Doors/GDScriptDoor/Row"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("4_dot")
MutedOutline = true

[node name="PathGap" type="Control" parent="Scroll/Margin/Column/Content"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
mouse_filter = 2

[node name="Path" type="Container" parent="Scroll/Margin/Column/Content" node_paths=PackedStringArray("CSharpTrack", "GDScriptTrack", "Ferret", "Speech")]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("5_tutorialpath")
CSharpTrack = NodePath("CSharpTrack")
GDScriptTrack = NodePath("GDScriptTrack")
Ferret = NodePath("Ferret")
Speech = NodePath("Bubble")

[node name="CSharpTrack" type="VBoxContainer" parent="Scroll/Margin/Column/Content/Path"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Step1" parent="Scroll/Margin/Column/Content/Path/CSharpTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 1
Track = 0

[node name="Step2" parent="Scroll/Margin/Column/Content/Path/CSharpTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 2
Track = 0

[node name="Step3" parent="Scroll/Margin/Column/Content/Path/CSharpTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 3
Track = 0

[node name="Step4" parent="Scroll/Margin/Column/Content/Path/CSharpTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 4
Track = 0

[node name="Step5" parent="Scroll/Margin/Column/Content/Path/CSharpTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 5
Track = 0

[node name="GDScriptTrack" type="VBoxContainer" parent="Scroll/Margin/Column/Content/Path"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="Step1" parent="Scroll/Margin/Column/Content/Path/GDScriptTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 1
Track = 1

[node name="Step2" parent="Scroll/Margin/Column/Content/Path/GDScriptTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 2
Track = 1

[node name="Step3" parent="Scroll/Margin/Column/Content/Path/GDScriptTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 3
Track = 1

[node name="Step4" parent="Scroll/Margin/Column/Content/Path/GDScriptTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 4
Track = 1

[node name="Step5" parent="Scroll/Margin/Column/Content/Path/GDScriptTrack" instance=ExtResource("6_steprow")]
layout_mode = 2
Number = 5
Track = 1

[node name="Bubble" type="PanelContainer" parent="Scroll/Margin/Column/Content/Path"]
offset_transform_enabled = true
offset_transform_rotation = -0.0349066
offset_transform_pivot_ratio = Vector2(0.5, 0.5)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"Bubble"
script = ExtResource("7_speechbubble")

[node name="Text" type="Label" parent="Scroll/Margin/Column/Content/Path/Bubble"]
layout_mode = 2
theme_type_variation = &"BubbleLabel"
text = "Oh my, so much ferret left, yet we're finished already?"
custom_minimum_size = Vector2(232, 0)
autowrap_mode = 3

[node name="Ferret" parent="Scroll/Margin/Column/Content/Path" instance=ExtResource("8_ferret")]
unique_name_in_owner = true
layout_mode = 2

[node name="CardsGap" type="Control" parent="Scroll/Margin/Column/Content"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
mouse_filter = 2

[node name="GoodToGo" type="Label" parent="Scroll/Margin/Column/Content"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "Good to go?"

[node name="Cards" type="GridContainer" parent="Scroll/Margin/Column/Content"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

[node name="ShapeMotion" parent="Scroll/Margin/Column/Content/Cards" instance=ExtResource("9_linkcard")]
layout_mode = 2
Title = "Shape motion"
Description = "Choose an ease or add an effect."
Path = "/easings/"

[node name="CombineMotions" parent="Scroll/Margin/Column/Content/Cards" instance=ExtResource("9_linkcard")]
layout_mode = 2
Title = "Combine motions"
Description = "Play sequences and parallel animations."
Path = "/{lang}/sequences/"

[node name="LoopMotion" parent="Scroll/Margin/Column/Content/Cards" instance=ExtResource("9_linkcard")]
layout_mode = 2
Title = "Loop a motion"
Description = "Add ping-pong, repeats, and delays."
Path = "/{lang}/loops/"

[node name="LookUpApi" parent="Scroll/Margin/Column/Content/Cards" instance=ExtResource("9_linkcard")]
layout_mode = 2
Title = "Look up an API"
Description = "Find members and property adapters."
Path = "/{lang}/api/"
