[gd_scene format=3]

[ext_resource type="Script" path="res://Pages/Hub/StepRow.cs" id="1_row"]
[ext_resource type="Script" path="res://Shell/Dot.cs" id="2_dot"]

[node name="StepRow" type="PanelContainer"]
theme_type_variation = &"StepRow"
script = ExtResource("1_row")
Normal = &"StepRow"
Rise = 0.0

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Dot" type="Control" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
size_flags_vertical = 0
mouse_filter = 2
script = ExtResource("2_dot")
Number = "1"

[node name="Copy" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Row/Copy"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StepTitle"
text = "Install"

[node name="Description" type="Label" parent="Row/Copy"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DoorHint"
text = "Add tweens.gd from the Godot Store or NuGet."
autowrap_mode = 3

[node name="Api" type="HFlowContainer" parent="Row/Copy"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="Begin" type="Label" parent="Row/Copy"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
text = "Start tutorial →"

[node name="Arrow" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 20
text = "→"
