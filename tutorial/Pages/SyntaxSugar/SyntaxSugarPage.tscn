layout_mode = 2
theme_override_constants/separation = 16
script = ExtResource("6_sugarsection")
CSharpScene = ExtResource("3_syntaxsugar")
GDScriptScene = ExtResource("4_syntax_sugar")
LeftMethods = PackedStringArray("Structured", "FullyStructured")
LeftLabels = PackedStringArray("Structured", "Fully Structured")
RightMethods = PackedStringArray("Convenient")
RightLabels = PackedStringArray("Convenient")
ShowTargets = true

[node name="Title" type="Label" parent="Scroll/Margin/Column/Content/Section1"]
