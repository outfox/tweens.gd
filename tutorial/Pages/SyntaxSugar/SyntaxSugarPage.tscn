[node name="Text" type="RichTextLabel" parent="Scroll/Margin/Column/Content/NotSeeingThings/Body"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3
script = ExtResource("5_prose")
Markdown = "There's more than one way to tween a ferret! While developing tweens.gd, we realized that there are at least two, probably four, problems that we wanted to solve.\n\nSome tweens may need...\n- to be fired off once, and just do their thing\n- destinations or timings you want to specify each time\n- to apply to several different targets (Nodes)\n- small variations for that extra juice"

[node name="Gap1" type="Control" parent="Scroll/Margin/Column/Content"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
mouse_filter = 2

