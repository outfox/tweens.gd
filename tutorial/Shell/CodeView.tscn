[gd_scene format=3]

[ext_resource type="Script" path="res://Shell/CodeView.cs" id="1_code"]
[ext_resource type="Script" path="res://Shell/PillButton.cs" id="2_pill"]

[node name="CodeView" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"CodePanel"
script = ExtResource("1_code")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Bar" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2

[node name="File" type="Label" parent="Layout/Bar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MonoLabel"
text = "Lesson.cs"

[node name="Copy" type="Button" parent="Layout/Bar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"FlatButton"
theme_override_font_sizes/font_size = 13
text = "Copy"
script = ExtResource("2_pill")

[node name="Body" type="MarginContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/margin_left = 0
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 0

[node name="Code" type="RichTextLabel" parent="Layout/Body"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"CodeLabel"
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 0
selection_enabled = true
