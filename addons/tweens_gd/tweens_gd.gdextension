[configuration]

entry_symbol = "tweens_gd_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

windows.debug.x86_64 = "bin/libtweens_gd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/libtweens_gd.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "bin/libtweens_gd.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "bin/libtweens_gd.windows.template_release.x86_32.dll"
windows.debug.arm64 = "bin/libtweens_gd.windows.template_debug.arm64.dll"
windows.release.arm64 = "bin/libtweens_gd.windows.template_release.arm64.dll"
linux.debug.x86_64 = "bin/libtweens_gd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libtweens_gd.linux.template_release.x86_64.so"
linux.debug.x86_32 = "bin/libtweens_gd.linux.template_debug.x86_32.so"
linux.release.x86_32 = "bin/libtweens_gd.linux.template_release.x86_32.so"
linux.debug.arm64 = "bin/libtweens_gd.linux.template_debug.arm64.so"
linux.release.arm64 = "bin/libtweens_gd.linux.template_release.arm64.so"
macos.debug = "bin/libtweens_gd.macos.template_debug.universal.dylib"
macos.release = "bin/libtweens_gd.macos.template_release.universal.dylib"
ios.debug = "bin/libtweens_gd.ios.template_debug.arm64.dylib"
ios.release = "bin/libtweens_gd.ios.template_release.arm64.dylib"
android.debug.arm64 = "bin/libtweens_gd.android.template_debug.arm64.so"
android.release.arm64 = "bin/libtweens_gd.android.template_release.arm64.so"
android.debug.arm32 = "bin/libtweens_gd.android.template_debug.arm32.so"
android.release.arm32 = "bin/libtweens_gd.android.template_release.arm32.so"
android.debug.x86_64 = "bin/libtweens_gd.android.template_debug.x86_64.so"
android.release.x86_64 = "bin/libtweens_gd.android.template_release.x86_64.so"
android.debug.x86_32 = "bin/libtweens_gd.android.template_debug.x86_32.so"
android.release.x86_32 = "bin/libtweens_gd.android.template_release.x86_32.so"
web.debug.threads.wasm32 = "bin/libtweens_gd.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "bin/libtweens_gd.web.template_release.wasm32.wasm"
web.debug.wasm32 = "bin/libtweens_gd.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "bin/libtweens_gd.web.template_release.wasm32.nothreads.wasm"
