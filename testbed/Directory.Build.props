<Project>
    <!-- Keep a Directory.Build.props above the project in effect (this file would otherwise shadow it). -->
    <PropertyGroup>
        <_TwoDogParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_TwoDogParentProps>
    </PropertyGroup>
    <Import Project="$(_TwoDogParentProps)" Condition="'$(_TwoDogParentProps)' != ''" />

    <PropertyGroup>
        <TwoDogRequireImport>true</TwoDogRequireImport>
    </PropertyGroup>

    <!-- The package versions every host references, also imported by tests/, testbed-gdscript/, benchmarks/ and
         build/Smoke.proj. 2dog floats to its newest stable build for Godot 4.7.2; keep it floating rather than
         pinning it with `2dog update`. The game project's Godot.NET.Sdk version stays in its csproj. -->
    <PropertyGroup Label="2dog">
        <TwoDogVersion>4.7.2.112</TwoDogVersion>
        <TwoDogNativesVersion>4.7.2.21</TwoDogNativesVersion>
        <TwoDogGodotVersion>4.7.2</TwoDogGodotVersion>
        <TwoDogAvaloniaVersion>12.1.1</TwoDogAvaloniaVersion>
        <TwoDogWindowsAppSdkVersion>2.4.0</TwoDogWindowsAppSdkVersion>
        <TwoDogAspNetCoreVersion>10.0.11</TwoDogAspNetCoreVersion>
    </PropertyGroup>
</Project>
