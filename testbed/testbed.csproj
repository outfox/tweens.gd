<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <IsPackable>false</IsPackable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- TwoDogWebBoot.cs (web hosts) takes a function pointer to the source-generated plugins initializer;
             harmless on desktop -->
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);testbed.2dog/**;testbed.tests/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="addons/tweens_gd/csharp/**/*.cs" />
        <ProjectReference Include="../csharp/tweens.gd.csproj" />
        <!-- Ship the exact compiled examples, including in trimmed/web exports. -->
        <EmbeddedResource Include="Gallery/**/*.cs" LogicalName="GallerySource/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="Gallery/**/*.gd" LogicalName="GallerySource/%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- Web bootstrap lives in the web host folder but must compile into THIS assembly: scripts resolve
             from the assembly holding the source-generated plugins initializer. Inert without a web host -->
        <Compile Include="testbed.web/TwoDogWebBoot.cs" Condition="Exists('$(MSBuildThisFileDirectory)testbed.web/TwoDogWebBoot.cs')" />
        <!-- The webxr host carries its own copy; compile it only when the plain
             web host's is absent (one definition per assembly). -->
        <Compile Include="testbed.webxr/TwoDogWebBoot.cs" Condition="!Exists('$(MSBuildThisFileDirectory)testbed.web/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)testbed.webxr/TwoDogWebBoot.cs')" />
        <!-- Same for the blazor host, last in line. -->
        <Compile Include="testbed.blazor/TwoDogWebBoot.cs" Condition="!Exists('$(MSBuildThisFileDirectory)testbed.web/TwoDogWebBoot.cs') And !Exists('$(MSBuildThisFileDirectory)testbed.webxr/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)testbed.blazor/TwoDogWebBoot.cs')" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="2dog.godotsharp" Version="$(TwoDogVersion)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)" Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'" />
    </ItemGroup>
    <!-- added by the 2dog tool: properties 2dog hosts need that were not already set -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);TWODOG_WEB_BOOT</DefineConstants>
    </PropertyGroup>
    <!-- added by the 2dog tool: properties 2dog hosts need that were not already set -->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);testbed.web/**</DefaultItemExcludes>
    </PropertyGroup>
    <Target Name="StageGDScriptAddon" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <GalleryAddon Include="../addons/tweens_gd/**/*" />
            <!-- Mirror the addon, including its committed .uid files: files removed from the source must not linger. -->
            <StagedGalleryAddon Include="addons/tweens_gd/**/*" />
            <StaleGalleryAddon Include="@(StagedGalleryAddon)" Exclude="@(GalleryAddon->'addons/tweens_gd/%(RecursiveDir)%(Filename)%(Extension)')" />
        </ItemGroup>
        <Delete Files="@(StaleGalleryAddon)" />
        <Copy SourceFiles="@(GalleryAddon)" DestinationFiles="@(GalleryAddon->'addons/tweens_gd/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
</Project>
