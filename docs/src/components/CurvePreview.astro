---
import { constant } from '../scripts/lang';

const eases = ['BackOut', 'SmoothStep', 'ElasticOut', 'BounceOut'];
const ghosts = Array.from({ length: 11 }, (_, i) => i);
---

<figure class="stage not-content" data-stage>
	<figcaption class="code">
		<span data-lang-only="csharp">
			<span class="t-kw">var</span> <span class="t-var">hop</span> = <span class="t-kw">new</span> <span class="t-ty">Tweens.Position2D</span>(to, <span class="t-num">0.9</span>, <span class="code-ease">EaseType.<span class="t-ease" data-ease-label="csharp">{eases[0]}</span>);</span><br />
			<span class="t-var">sprite</span>.<span class="t-fn">Tween</span>(<span class="t-var">hop</span>);
		</span>
		<span data-lang-only="gdscript">
			<span class="t-kw">var</span> <span class="t-var">hop</span> := Tweens.<span class="t-fn">position_2d</span>(to, <span class="t-num">0.9</span>, <span class="code-ease">Tweens.Ease.<span class="t-ease" data-ease-label="gdscript">{constant(eases[0])}</span>)</span><br />
			Tweens.<span class="t-fn">play</span>(<span class="t-var">sprite</span>, <span class="t-var">hop</span>)
		</span>
	</figcaption>

	<div class="motion">
		<svg class="diagram lane" viewBox="0 0 144 254" aria-hidden="true">
			<rect class="overshoot" x="16" y="16" width="40" height="58" rx="20"></rect>
			<text class="endlabel faint" x="66" y="45">overshoot</text>
			<line class="rail" x1="36" y1="226" x2="36" y2="90"></line>
			<circle class="endpoint" cx="36" cy="226" r="5"></circle>
			<circle class="endpoint" cx="36" cy="90" r="5"></circle>
			<text class="endlabel" x="66" y="226">From</text>
			<text class="endlabel" x="66" y="90">To</text>
			<g data-ghosts>
				{ghosts.map(() => <circle class="ghost" cx="36" r="12" />)}
			</g>
			<g data-ball transform="translate(36 226)">
				<g data-squash>
					<circle class="ball" r="14"></circle>
					<circle class="shine" cx="-5" cy="-5" r="4"></circle>
				</g>
			</g>
		</svg>
		<svg class="diagram plot" viewBox="0 0 240 254" preserveAspectRatio="none" aria-hidden="true">
			<g>
				<path class="grid" d="M0 226H240M0 90H240"></path>
				<path class="curve" data-curve d=""></path>
				<path class="tracer" data-tracer d="M0 226h0"></path>
			</g>
		</svg>
		<div class="readout">
			<span><span class="k">progress</span> <span data-progress>0.00</span></span>
			<span><span class="k">weight</span> <span data-weight>0.00</span></span>
		</div>
	</div>

	<div class="picker" role="group" aria-label="Easing">
		{
			eases.map((e, i) => (
				<button type="button" class="pick" data-ease={e} aria-pressed={i === 0 ? 'true' : 'false'}>
					<span data-lang-only="csharp">{e}</span>
					<span data-lang-only="gdscript">{constant(e)}</span>
				</button>
			))
		}
	</div>
	<p class="sr-only" aria-live="polite" data-announce></p>
</figure>

<script>
	import { EASES, type EaseName, loop, reducedMotion } from '../scripts/motion';
	import { constant } from '../scripts/lang';

	// Lane and plot leave room for the largest overshoot among the presets (ElasticOut peaks near 1.37).
	const FROM = 226;
	const TO = 90;
	const LANE_X = 36;
	const REWIND = 0.35;
	const HOLD = 0.25;
	const LEG = 0.9;
	// Each play slides the ball home, holds, runs the leg once, then rests at the end until the next pick.
	const START = REWIND + HOLD;
	const END = START + LEG;
	const laneY = (w: number) => FROM + (TO - FROM) * w;
	// The ball and curve share the same vertical scale and From/To baselines.
	const plotY = laneY;
	// Stronger BackOut for this preview: 30% overshoot instead of 10%.
	// Keep this presentation adjustment local; the reference demos use the library's curve.
	const HERO_BACK = 3.3940516581445603;
	const previewEase = (name: EaseName, t: number) =>
		name === 'BackOut' ? 1 + (HERO_BACK + 1) * (t - 1) ** 3 + HERO_BACK * (t - 1) ** 2 : EASES[name](t);

	const plotPath = (name: EaseName) => {
		let d = '';
		for (let i = 0; i <= 96; i++) d += `${i ? 'L' : 'M'}${(i * 2.5).toFixed(1)} ${plotY(previewEase(name, i / 96)).toFixed(2)}`;
		return d;
	};

	for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
		const $ = <T extends Element>(s: string) => stage.querySelector<T>(s)!;
		const labels = [...stage.querySelectorAll<HTMLElement>('[data-ease-label]')];
		const ball = $<SVGGElement>('[data-ball]');
		const squash = $<SVGGElement>('[data-squash]');
		const ghosts = [...stage.querySelectorAll<SVGCircleElement>('.ghost')];
		const curve = $<SVGPathElement>('[data-curve]');
		const tracer = $<SVGPathElement>('[data-tracer]');
		const progressOut = $<HTMLElement>('[data-progress]');
		const weightOut = $<HTMLElement>('[data-weight]');
		const picks = [...stage.querySelectorAll<HTMLButtonElement>('.pick')];
		const names = picks.map((p) => p.dataset.ease as EaseName);

		const announce = $<HTMLElement>('[data-announce]');

		let index = 0;
		let now = 0;
		let playStart = 0;
		let playing = true;
		let rewindFrom = FROM;
		let y = FROM;
		let lastY = FROM;

		const setEase = (i: number) => {
			index = i;
			labels.forEach((l) => (l.textContent = l.dataset.easeLabel === 'gdscript' ? constant(names[i]) : names[i]));
			curve.setAttribute('d', plotPath(names[i]));
			picks.forEach((p, k) => p.setAttribute('aria-pressed', String(k === i)));
			for (const g of ghosts) g.style.opacity = '0';
		};

		const render = (local: number) => {
			const name = names[index];
			const p = Math.min(1, Math.max(0, (local - START) / LEG));
			const w = previewEase(name, p);
			if (local < REWIND) {
				// The ball slides home from wherever the last play left it.
				y = rewindFrom + (FROM - rewindFrom) * EASES.SmootherStep(local / REWIND);
			} else {
				y = laneY(w);
				// Onion skin: one ring per tenth of the leg's time.
				ghosts.forEach((g, k) => {
					const gp = k / (ghosts.length - 1);
					if (p >= gp && g.style.opacity === '0') {
						g.setAttribute('cy', laneY(previewEase(name, gp)).toFixed(2));
						g.style.opacity = '1';
					}
				});
			}

			// Stretch along the vertical motion, preserving area.
			const stretch = 1 + Math.min(0.45, Math.abs(y - lastY) / 24);
			lastY = y;
			ball.setAttribute('transform', `translate(${LANE_X} ${y.toFixed(2)})`);
			squash.setAttribute('transform', `scale(${(1 / stretch).toFixed(3)} ${stretch.toFixed(3)})`);

			tracer.style.opacity = local < REWIND ? '0' : '1';
			tracer.setAttribute('d', `M${(p * 240).toFixed(2)} ${plotY(w).toFixed(2)}h0`);
			progressOut.textContent = p.toFixed(2);
			weightOut.textContent = w.toFixed(2);
		};

		const frame = (t: number) => {
			now = t;
			if (!playing) return;
			const local = t - playStart;
			if (local >= END) playing = false;
			render(Math.min(local, END));
		};

		const play = (i: number) => {
			setEase(i);
			rewindFrom = y;
			playStart = now;
			playing = true;
			if (reducedMotion()) {
				playing = false;
				render(END);
			}
		};

		picks.forEach((p, k) =>
			p.addEventListener('click', () => {
				play(k);
				announce.textContent = `${names[k]} selected`;
			}),
		);

		setEase(0);
		if (reducedMotion()) render(END);
		else loop(stage, frame);
	}
</script>

<style>
	.stage {
		container-type: inline-size;
		margin: 1.5rem 0 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid var(--tw-outline);
		border-radius: 1.5rem;
		background:
			radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--tw-blue) 10%, transparent), transparent 60%),
			var(--tw-stage);
		box-shadow: var(--tw-shadow);
		min-width: 0;
	}
	.code {
		font-family: var(--sl-font-mono);
		font-variant-ligatures: none;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--tw-muted);
		padding: 0.75rem;
		border-radius: 0.8rem;
		background: color-mix(in oklab, var(--tw-code-inset) 70%, transparent);
		overflow-wrap: normal;
	}
	.code-ease {
		display: inline-block;
	}
	.t-var {
		color: var(--sl-color-white);
	}
	.t-kw {
		color: var(--tw-blue-ink);
	}
	.t-ty {
		color: var(--tw-mint-ink);
	}
	.t-fn {
		color: var(--tw-amber-ink);
	}
	.t-num {
		color: var(--tw-amber-ink);
	}
	.t-ease {
		display: inline-block;
		color: var(--tw-mint-ink);
		font-weight: 700;
	}
	.motion {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr);
		gap: 0.5rem 1rem;
		align-items: start;
	}
	.diagram {
		display: block;
		width: 100%;
		height: 14.111rem;
		overflow: visible;
	}
	.plot {
		padding-inline-end: 0.5rem;
	}
	.plot :is(path, circle) {
		vector-effect: non-scaling-stroke;
	}
	.rail {
		stroke: var(--tw-outline);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-dasharray: 1 9;
	}
	.endpoint {
		fill: var(--tw-muted);
	}
	.overshoot {
		fill: none;
		stroke: color-mix(in oklab, var(--tw-amber) 35%, transparent);
		stroke-dasharray: 3 5;
	}
	.endlabel.faint {
		fill: var(--tw-amber-ink);
		font-weight: 500;
	}
	.endlabel {
		fill: var(--tw-muted);
		font: 600 12px var(--sl-font);
		text-anchor: start;
		dominant-baseline: middle;
	}
	.ghost {
		fill: none;
		stroke: var(--tw-mint);
		stroke-width: 2;
		opacity: 0;
		transition: opacity 0.35s ease-out;
	}
	[data-ghosts] {
		opacity: 0.4;
	}
	.ball {
		fill: var(--tw-mint);
	}
	.shine {
		fill: #fff;
		opacity: 0.55;
	}
	.plot .grid {
		stroke: var(--tw-grid);
		stroke-dasharray: 3 5;
	}
	.curve {
		fill: none;
		stroke: var(--tw-blue);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.tracer {
		transition: opacity 0.2s;
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 8;
		stroke-linecap: round;
	}
	.readout {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: flex-end;
		padding-inline-end: 0.5rem;
		font: 0.75rem var(--sl-font-mono);
		font-variant-numeric: tabular-nums;
	}
	.readout .k {
		color: var(--tw-muted);
	}
	.picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: start;
		gap: 0.4rem;
		padding-top: 1rem;
		border-top: 1px solid var(--tw-outline);
	}
	.pick {
		all: unset;
		flex: 1 1 auto;
		text-align: center;
		cursor: pointer;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: var(--tw-soft);
		background: var(--tw-raised);
		transition:
			translate 0.35s var(--ease-back-out),
			background-color 0.2s,
			color 0.2s;
	}
	.pick:hover {
		translate: 0 -2px;
		color: var(--sl-color-white);
	}
	.pick:focus-visible {
		outline: 2px solid var(--tw-accent);
		outline-offset: 2px;
	}
	.pick[aria-pressed='true'] {
		background: var(--tw-accent);
		color: var(--tw-on-accent);
	}
	:root[data-theme='light'] .pick[aria-pressed='true'] {
		background: var(--tw-accent-ink);
	}
	@media (pointer: coarse) {
		.pick {
			padding-block: 0.65rem;
		}
	}
	@container (max-width: 24rem) {
		.code {
			font-size: 0.75rem;
		}
		.motion {
			gap: 0.5rem;
		}
		.picker {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.pick {
			padding-inline: 0.25rem;
		}
	}
</style>
