---
import { Icon } from '@astrojs/starlight/components';
import { LANGS, LEARN } from '../tracks.mjs';

interface Props {
	lang: 'csharp' | 'gdscript';
}
const { lang } = Astro.props;
const label = LANGS[lang].label;
const descriptions: Record<string, string> = {
	installation: lang === 'csharp' ? 'Add the C# library to your Godot project.' : 'Copy the addon into your Godot project.',
	quickstart: 'Move a sprite, then fade it out.',
	definitions: 'Name motion once and reuse it everywhere.',
	sequences: 'Chain, group, and stagger steps.',
	playback: 'Pause, cancel, and handle every ending.',
};
const steps = LEARN.map((page) => ({
	slug: page.slug,
	title: page[lang] ?? page.label,
	text: descriptions[page.slug],
}));
---

<nav class="path not-content tw-wide" aria-label={`${label} tutorial`}>
	<ol>
		{steps.map((step, i) => (
			<li>
				<a href={`/${lang}/${step.slug}/`}>
					<span class="number" aria-hidden="true">{i + 1}</span>
					<span class="step-copy">
						<span class="title">{step.title}</span>
						<span class="description">{step.text}</span>
					</span>
					{i === 0 ? (
						<span class="begin">Start tutorial <Icon name="right-arrow" /></span>
					) : <Icon name="right-arrow" class="arrow" />}
				</a>
			</li>
		))}
	</ol>
</nav>

<style>
	.path {
		margin-block: 1.5rem 3rem;
		container-type: inline-size;
	}
	ol {
		--dot: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	li { position: relative; margin: 0; min-width: 0; }
	li:not(:last-child)::after {
		content: '';
		position: absolute;
		z-index: 1;
		top: calc(1rem + var(--dot));
		bottom: -1.5rem;
		left: calc(1rem + var(--dot) / 2 - 1px);
		width: 2px;
		background: var(--tw-outline);
		pointer-events: none;
	}
	a {
		display: grid;
		grid-template-columns: var(--dot) minmax(0, 1fr) auto;
		align-items: start;
		gap: 0.75rem 1rem;
		height: 100%;
		padding: 1rem;
		border-radius: 0.75rem;
		color: var(--sl-color-white);
		text-decoration: none;
		transition: background-color 0.2s;
	}
	a:hover { background-color: var(--tw-surface); }
	a:focus-visible { outline: 2px solid var(--tw-mint-ink); outline-offset: 3px; }
	.number {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		width: var(--dot);
		height: var(--dot);
		border: 1px solid var(--tw-outline);
		border-radius: 50%;
		background: var(--tw-bg);
		color: var(--tw-muted);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.step-copy { display: grid; gap: 0.4rem; }
	.title { font: 700 1.15rem / 1.3 var(--tw-font-display); }
	.description { color: var(--tw-soft); font-size: var(--sl-text-sm); line-height: 1.5; }
	.arrow { align-self: center; color: var(--tw-mint-ink); font-size: 1.25rem; }
	li:first-child a { background: var(--tw-selected); }
	li:first-child a:hover { background: color-mix(in oklab, var(--tw-mint) 12%, var(--tw-selected)); }
	li:first-child .number {
		background: var(--tw-mint-ink);
		border-color: var(--tw-mint-ink);
		color: var(--tw-on-accent);
	}
	a:hover .title { color: var(--tw-mint-ink); }
	.begin {
		grid-column: 2 / -1;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--tw-mint-ink);
		font-size: var(--sl-text-sm);
		font-weight: 700;
	}
	.begin :global(svg) { flex-shrink: 0; font-size: 1.25rem; }
	@container (min-width: 54rem) {
		ol { grid-template-columns: repeat(5, minmax(0, 1fr)); }
		li:not(:last-child)::after {
			top: calc(1rem + var(--dot) / 2 - 1px);
			left: calc(1rem + var(--dot));
			right: -1.5rem;
			bottom: auto;
			width: auto;
			height: 2px;
		}
		a { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr auto; gap: 1rem; }
		.step-copy { align-content: start; }
		.title { min-height: 2.6em; }
		.begin { grid-column: 1; }
		.arrow { align-self: end; }
	}
	@media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
