---
// Starlight's header with the language switch beside the site title. Pagefind search is always enabled on this site.
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LangSwitch from '../LangSwitch.astro';
import SiteTitle from './SiteTitle.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<div class="lang sl-hidden md:sl-flex print:hidden">
			<LangSwitch />
		</div>
	</div>
	<div class="sl-flex print:hidden">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			align-items: center;
			gap: 1.25rem;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			/* Starlight's columns for a docs page with a sidebar and no table of contents, used on every page, so the
			   search keeps its place when navigating to or from the splash pages (overview, 404). */
			.header {
				--__sidebar-width: max(0rem, var(--sl-sidebar-width) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(100% + 2 * var(--sl-nav-pad-x) - var(--sl-sidebar-width) - var(--tw-docs-width)) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
					1fr
					auto;
				align-content: center;
			}
		}
	}
</style>
