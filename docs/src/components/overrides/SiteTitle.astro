---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
		<rect width="64" height="64" rx="16" class="tile" />
		<path class="curve" d="M12 48C36 48 28 16 52 16" />
		<circle class="end" cx="52" cy="16" r="4.5" />
		<circle class="runner" r="6" />
	</svg>
	<span class="word" translate="no">
		{siteTitle.replace('.gd', '')}<span class="ext">.gd</span>
	</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.mark {
		width: 2.1rem;
		height: 2.1rem;
		flex: none;
		overflow: visible;
		transition: rotate 0.6s var(--ease-back-out);
	}
	.tile {
		fill: var(--tw-surface);
		stroke: var(--tw-outline);
		stroke-width: 2;
	}
	.curve {
		fill: none;
		stroke: var(--tw-accent);
		stroke-width: 6;
		stroke-linecap: round;
	}
	.end {
		fill: var(--tw-muted);
	}
	.runner {
		fill: var(--sl-color-white);
		offset-path: path('M12 48C36 48 28 16 52 16');
		offset-distance: 0%;
		transition: offset-distance 0.9s var(--ease-elastic-out);
	}
	.site-title:hover .runner,
	.site-title:focus-visible .runner {
		offset-distance: 100%;
	}
	.site-title:hover .mark {
		rotate: -6deg;
	}
	.word {
		font-family: var(--tw-font-display);
		font-size: 1.35rem;
		font-weight: 780;
		letter-spacing: -0.03em;
	}
	.ext {
		color: var(--tw-mint-ink);
		display: inline-block;
		transition: translate 0.5s var(--ease-bounce-out);
	}
	.site-title:hover .ext {
		translate: 0 -0.12em;
	}
	/* On phones the language switch takes the word's place; the word stays as the link's accessible name. */
	@media (max-width: 30rem) {
		.word {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
	}
</style>
