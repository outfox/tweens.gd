---
import SectionArt, { type Section } from '../SectionArt.astro';
import { LANGS, PATH, slugOf, trackOf } from '../../tracks.mjs';

const PAGE_TITLE_ID = '_top'; // Starlight's skip-link target
const { id, entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const lang = trackOf(id) as keyof typeof LANGS | undefined;
const language = lang && LANGS[lang];
// One drawing per stretch of the learning path, the same in both languages; shared pages use the catalog drawing.
const slug = lang ? slugOf(id) : undefined;
const section = (PATH.find((g) => g.pages.some((p) => p.slug === slug))?.art ??
	(id === 'compatibility' || id === 'acknowledgements' ? 'catalog' : undefined)) as Section | undefined;
// Search results list both languages' twins, so their titles carry the language.
const searchTitle = language ? `title:${title} (${language.label})` : undefined;
// Letters are split so a hover can ripple through them like a staggered tween list.
let i = 0;
const words = title.split(' ').map((word) => [...word].map((ch) => ({ ch, i: i++ })));
---

<div class="title-row">
	<div class="heading">
		{
			language && (
				<p class="lang-tag">
					<span>{language.label}</span>
					{language.status && <span class="status">{language.status}</span>}
				</p>
			)
		}
		<h1 id={PAGE_TITLE_ID} data-pagefind-meta={searchTitle}>
			<span class="sr-only">{title}</span>
			<span class="letters" aria-hidden="true">
				{
					words.map((letters, w) => (
						<>
							{w > 0 && ' '}
							<span class="word">
								{letters.map(({ ch, i }) => (
									<span class="ch" style={`--i:${i}`}>
										{ch}
									</span>
								))}
							</span>
						</>
					))
				}
			</span>
		</h1>
	</div>
	{
		section && (
			<div class="art">
				<SectionArt kind={section} />
			</div>
		)
	}
</div>

<style>
	.title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: 1rem;
	}
	h1 {
		margin: 0;
		font-size: var(--sl-text-h1);
		line-height: 1.05;
		font-weight: 780;
		font-stretch: 88%;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.lang-tag {
		display: flex;
		gap: 0.4rem;
		margin: 0 0 0.6rem;
		font: 650 var(--sl-text-xs) / 1 var(--sl-font-mono);
	}
	.lang-tag span {
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		background: var(--tw-selected);
		color: var(--tw-mint-ink);
	}
	.lang-tag .status {
		background: color-mix(in oklab, var(--tw-amber) 18%, transparent);
		color: var(--tw-amber-ink);
	}
	.word {
		display: inline-block;
		white-space: nowrap;
	}
	.ch {
		display: inline-block;
		transform-origin: 50% 100%;
	}
	/* Titles sit still on load; hovering one sends a hop through its letters. */
	h1:hover .ch {
		animation: hop 0.6s ease-out both;
		animation-delay: calc(var(--i) * 18ms);
	}
	@keyframes hop {
		0% {
			translate: 0 0;
		}
		30% {
			translate: 0 -0.18em;
			scale: 0.96 1.06;
		}
		100% {
			translate: 0 0;
			scale: 1;
		}
	}
	.art {
		flex: 0 0 auto;
		width: clamp(5.5rem, 16vw, 9rem);
	}
	@media (max-width: 30rem) {
		.title-row {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 0.75rem;
		}
		.art {
			width: 5.5rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		h1:hover .ch {
			animation: none;
		}
	}
</style>
