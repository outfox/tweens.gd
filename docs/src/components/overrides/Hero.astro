---
import { LinkButton } from '@astrojs/starlight/components';
import { constant } from '../../scripts/lang';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const facts = data.facts ?? [];

const [name, ext] = title.split('.');
const eases = ['BackOut', 'SmootherStep', 'ElasticOut', 'SmoothStep', 'BounceOut'];
const ghosts = Array.from({ length: 11 }, (_, i) => i);
---

<div class="hero">
	<div class="copy">
		<h1 id="_top" data-page-title>
			<span class="sr-only">{title}</span>
			<span class="letters" aria-hidden="true">
				{
					[...name].map((ch, i) => (
						<span class="ch" style={`--i:${i}`}>
							{ch}
						</span>
					))
				}
				{
					ext && (
						<>
							<span class="dot" style={`--i:${name.length + 2}`} />
							{[...ext].map((ch, i) => (
								<span class="ch ext" style={`--i:${name.length + 1 + i}`}>
									{ch}
								</span>
							))}
						</>
					)
				}
			</span>
		</h1>
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			data.heroDescription ? (
				<p class="lede" set:html={data.heroDescription} />
			) : (
				data.description && <p class="lede">{data.description}</p>
			)
		}
		{
			facts.length > 0 && (
				<ul class="facts">
					{facts.map(({ text, link }) => (
						<li>{link ? <a href={link}>{text}</a> : text}</li>
					))}
				</ul>
			)
		}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>

	<figure class="stage" data-stage>
		<figcaption class="code">
			<span data-lang-only="csharp">
				<span class="t-kw">var</span> <span class="t-var">hop</span> = <span class="t-kw">new</span> <span class="t-ty">Tweens.Position2D</span>(to, <span class="t-num">0.9</span>,<br />
				<span class="indent">EaseType.<span class="t-ease" data-ease-label="csharp">{eases[0]}</span>);</span><br />
				<span class="t-var">sprite</span>.<span class="t-fn">Tween</span>(<span class="t-var">hop</span>);
			</span>
			<span data-lang-only="gdscript">
				<span class="t-kw">var</span> <span class="t-var">hop</span> := Tweens.<span class="t-fn">position_2d</span>(to, <span class="t-num">0.9</span>,<br />
				<span class="indent">Tweens.Ease.<span class="t-ease" data-ease-label="gdscript">{constant(eases[0])}</span>)</span><br />
				Tweens.<span class="t-fn">play</span>(<span class="t-var">sprite</span>, <span class="t-var">hop</span>)
			</span>
		</figcaption>

		<svg class="lane" viewBox="0 0 400 84" aria-hidden="true">
			<rect class="overshoot" x="286" y="26" width="104" height="40" rx="20"></rect>
			<text class="endlabel faint" x="338" y="80">overshoot</text>
			<line class="rail" x1="30" y1="46" x2="280" y2="46"></line>
			<circle class="endpoint" cx="30" cy="46" r="5"></circle>
			<circle class="endpoint" cx="280" cy="46" r="5"></circle>
			<text class="endlabel" x="30" y="80">From</text>
			<text class="endlabel" x="280" y="80">To</text>
			<g data-ghosts>
				{ghosts.map(() => <circle class="ghost" cy="46" r="12" />)}
			</g>
			<g data-ball transform="translate(30 46)">
				<g data-squash>
					<circle class="ball" r="14"></circle>
					<circle class="shine" cx="-5" cy="-5" r="4"></circle>
				</g>
			</g>
		</svg>

		<div class="plot">
			<svg viewBox="0 0 240 114" aria-hidden="true">
				<path class="grid" d="M0 106H240M0 36H240"></path>
				<path class="curve" data-curve d=""></path>
				<circle class="tracer" data-tracer r="5" cx="0" cy="106"></circle>
			</svg>
			<div class="readout">
				<span class="tw-chip"><span class="k">progress</span> <span data-progress>0.00</span></span>
				<span class="tw-chip"><span class="k">weight</span> <span data-weight>0.00</span></span>
			</div>
		</div>

		<div class="picker" role="group" aria-labelledby="hero-picker-label">
			<span class="picker-label" id="hero-picker-label">Pick an ease</span>
			{
				eases.map((e, i) => (
					<button type="button" class="pick" data-ease={e} aria-pressed={i === 0 ? 'true' : 'false'}>
						<span data-lang-only="csharp">{e}</span>
						<span data-lang-only="gdscript">{constant(e)}</span>
					</button>
				))
			}
		</div>
		<p class="sr-only" aria-live="polite" data-announce></p>
	</figure>
</div>

<script>
	import { EASES, type EaseName, loop, reducedMotion } from '../../scripts/motion';
	import { constant } from '../../scripts/lang';

	// Lane and plot leave room for the largest overshoot among the presets (ElasticOut peaks near 1.37).
	const FROM = 30;
	const TO = 280;
	const REWIND = 0.35;
	const HOLD = 0.25;
	const LEG = 0.9;
	// Each play slides the ball home, holds, runs the leg once, then rests at the end until the next pick.
	const START = REWIND + HOLD;
	const END = START + LEG;
	const laneX = (w: number) => FROM + (TO - FROM) * w;
	const plotY = (w: number) => 106 - w * 70;

	const plotPath = (name: EaseName) => {
		let d = '';
		for (let i = 0; i <= 96; i++) d += `${i ? 'L' : 'M'}${(i * 2.5).toFixed(1)} ${plotY(EASES[name](i / 96)).toFixed(2)}`;
		return d;
	};

	for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
		const $ = <T extends Element>(s: string) => stage.querySelector<T>(s)!;
		const labels = [...stage.querySelectorAll<HTMLElement>('[data-ease-label]')];
		const ball = $<SVGGElement>('[data-ball]');
		const squash = $<SVGGElement>('[data-squash]');
		const ghosts = [...stage.querySelectorAll<SVGCircleElement>('.ghost')];
		const curve = $<SVGPathElement>('[data-curve]');
		const tracer = $<SVGCircleElement>('[data-tracer]');
		const progressOut = $<HTMLElement>('[data-progress]');
		const weightOut = $<HTMLElement>('[data-weight]');
		const picks = [...stage.querySelectorAll<HTMLButtonElement>('.pick')];
		const names = picks.map((p) => p.dataset.ease as EaseName);

		const announce = $<HTMLElement>('[data-announce]');

		let index = 0;
		let now = 0;
		let playStart = 0;
		let playing = true;
		let rewindFrom = FROM;
		let x = FROM;
		let lastX = FROM;

		const setEase = (i: number) => {
			index = i;
			labels.forEach((l) => (l.textContent = l.dataset.easeLabel === 'gdscript' ? constant(names[i]) : names[i]));
			curve.setAttribute('d', plotPath(names[i]));
			picks.forEach((p, k) => p.setAttribute('aria-pressed', String(k === i)));
			for (const g of ghosts) g.style.opacity = '0';
		};

		const render = (local: number) => {
			const name = names[index];
			const p = Math.min(1, Math.max(0, (local - START) / LEG));
			const w = EASES[name](p);
			if (local < REWIND) {
				// The ball slides home from wherever the last play left it.
				x = rewindFrom + (FROM - rewindFrom) * EASES.SmootherStep(local / REWIND);
			} else {
				x = laneX(w);
				// Onion skin: one ring per tenth of the leg's time.
				ghosts.forEach((g, k) => {
					const gp = k / (ghosts.length - 1);
					if (p >= gp && g.style.opacity === '0') {
						g.setAttribute('cx', laneX(EASES[name](gp)).toFixed(2));
						g.style.opacity = '1';
					}
				});
			}

			// Squash and stretch from horizontal speed, preserving area.
			const stretch = 1 + Math.min(0.45, Math.abs(x - lastX) / 24);
			lastX = x;
			ball.setAttribute('transform', `translate(${x.toFixed(2)} 46)`);
			squash.setAttribute('transform', `scale(${stretch.toFixed(3)} ${(1 / stretch).toFixed(3)})`);

			tracer.style.opacity = local < REWIND ? '0' : '1';
			tracer.setAttribute('cx', (p * 240).toFixed(2));
			tracer.setAttribute('cy', plotY(w).toFixed(2));
			progressOut.textContent = p.toFixed(2);
			weightOut.textContent = w.toFixed(2);
		};

		const frame = (t: number) => {
			now = t;
			if (!playing) return;
			const local = t - playStart;
			if (local >= END) playing = false;
			render(Math.min(local, END));
		};

		const play = (i: number) => {
			setEase(i);
			rewindFrom = x;
			playStart = now;
			playing = true;
			if (reducedMotion()) {
				playing = false;
				render(END);
			}
		};

		picks.forEach((p, k) =>
			p.addEventListener('click', () => {
				play(k);
				announce.textContent = `${names[k]} selected`;
			}),
		);

		setEase(0);
		if (reducedMotion()) render(END);
		else loop(stage, frame);
	}
</script>

<style>
	.hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		padding-block: 1.5rem 2rem;
	}
	@media (min-width: 62rem) {
		.hero {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			gap: 3.5rem;
			padding-block: clamp(2.5rem, 8vmin, 6rem) 3rem;
		}
	}
	.copy {
		display: grid;
		gap: 1.4rem;
		justify-items: start;
	}
	h1 {
		margin: 0;
		font-family: var(--tw-font-display);
		font-size: clamp(3.4rem, 9vw, 6rem);
		line-height: 0.95;
		font-weight: 800;
		font-stretch: 90%;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
	}
	.letters {
		display: inline-flex;
		align-items: baseline;
	}
	.ch {
		display: inline-block;
		transform-origin: 50% 100%;
	}
	/* The wordmark waits for a hover, then each letter hops in turn. */
	h1:hover .ch {
		animation: hop 0.6s ease-out both;
		animation-delay: calc(var(--i) * 45ms);
	}
	.ext {
		color: var(--tw-mint-ink);
	}
	.dot {
		display: inline-block;
		width: 0.2em;
		height: 0.2em;
		margin-inline: 0.04em 0.05em;
		border-radius: 50%;
		background: var(--tw-mint);
		transition: scale 0.5s var(--ease-elastic-out);
	}
	h1:hover .dot {
		scale: 1.35;
	}
	@keyframes hop {
		0% {
			translate: 0 0;
			scale: 1.1 0.9;
		}
		30% {
			translate: 0 -0.28em;
			scale: 0.94 1.08;
		}
		100% {
			translate: 0 0;
			scale: 1;
		}
	}
	.tagline {
		margin: 0;
		max-width: 26ch;
		font-family: var(--tw-font-display);
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		line-height: 1.2;
		font-weight: 600;
		font-stretch: 94%;
		color: var(--tw-soft);
		text-wrap: balance;
	}
	.lede {
		margin: -0.4rem 0 0;
		max-width: 34rem;
		font-size: var(--sl-text-lg);
		line-height: 1.5;
		color: var(--tw-soft);
		text-wrap: pretty;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.facts li {
		margin: 0;
		padding: 0.2rem 0.7rem;
		border: 1px solid var(--tw-outline);
		border-radius: 999px;
		font: 500 var(--sl-text-xs) var(--sl-font-mono);
		color: var(--tw-soft);
	}
	/* Status links use the same amber accent as the sidebar badges. */
	.facts li:has(a) {
		border-color: color-mix(in oklab, var(--tw-amber) 55%, transparent);
		background: color-mix(in oklab, var(--tw-amber) 12%, transparent);
	}
	.facts a {
		color: var(--tw-amber-ink);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
		text-underline-offset: 0.2em;
	}
	.facts a:hover {
		text-decoration-color: currentColor;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: center;
	}

	.stage {
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.25rem;
		padding: 1.1rem 1.1rem 1rem;
		border: 1px solid var(--tw-outline);
		border-radius: 1.5rem;
		background:
			radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--tw-blue) 10%, transparent), transparent 60%),
			var(--tw-stage);
		box-shadow: var(--tw-shadow);
		min-width: 0;
	}
	.code {
		font-family: var(--sl-font-mono);
		font-variant-ligatures: none;
		font-size: clamp(0.7rem, 1.6vw, 0.82rem);
		line-height: 1.6;
		color: var(--tw-muted);
		padding: 0.55rem 0.8rem;
		border-radius: 0.8rem;
		background: color-mix(in oklab, var(--tw-bg) 70%, transparent);
		overflow-wrap: anywhere;
	}
	.t-var {
		color: var(--sl-color-white);
	}
	.indent {
		display: inline-block;
		padding-left: 4ch;
	}
	.t-kw {
		color: var(--tw-blue-ink);
	}
	.t-ty {
		color: var(--tw-mint-ink);
	}
	.t-fn {
		color: var(--tw-amber-ink);
	}
	.t-num {
		color: var(--tw-amber-ink);
	}
	.t-ease {
		display: inline-block;
		color: var(--tw-mint-ink);
		font-weight: 700;
	}
	.lane {
		width: 100%;
		overflow: hidden;
		margin-top: 0.5rem;
	}
	.rail {
		stroke: var(--tw-outline);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-dasharray: 1 9;
	}
	.endpoint {
		fill: var(--tw-muted);
	}
	.overshoot {
		fill: none;
		stroke: color-mix(in oklab, var(--tw-amber) 35%, transparent);
		stroke-dasharray: 3 5;
	}
	.endlabel.faint {
		fill: var(--tw-amber-ink);
		font-weight: 500;
	}
	.endlabel {
		fill: var(--tw-muted);
		font: 600 12px var(--sl-font);
		text-anchor: middle;
	}
	.ghost {
		fill: none;
		stroke: var(--tw-mint);
		stroke-width: 2;
		opacity: 0;
		transition: opacity 0.35s ease-out;
	}
	[data-ghosts] {
		opacity: 0.4;
	}
	.ball {
		fill: var(--tw-mint);
	}
	.shine {
		fill: #fff;
		opacity: 0.55;
	}
	.plot {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: end;
	}
	.plot svg {
		width: 100%;
		max-height: 9rem;
		overflow: hidden;
	}
	.plot .grid {
		stroke: var(--tw-grid);
		stroke-dasharray: 3 5;
	}
	.curve {
		fill: none;
		stroke: var(--tw-blue);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.tracer {
		transition: opacity 0.2s;
		fill: var(--sl-color-white);
		stroke: var(--tw-blue);
		stroke-width: 3;
	}
	.readout {
		display: grid;
		gap: 0.4rem;
		justify-items: end;
	}
	.readout .k {
		color: var(--tw-muted);
	}
	.picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}
	.picker-label {
		flex-basis: 100%;
		margin-bottom: 0.1rem;
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.pick {
		all: unset;
		cursor: pointer;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: var(--tw-soft);
		background: var(--tw-raised);
		transition:
			translate 0.35s var(--ease-back-out),
			background-color 0.2s,
			color 0.2s;
	}
	.pick:hover {
		translate: 0 -2px;
		color: var(--sl-color-white);
	}
	.pick:focus-visible {
		outline: 2px solid var(--tw-mint);
		outline-offset: 2px;
	}
	.pick[aria-pressed='true'] {
		background: var(--tw-mint);
		color: var(--tw-on-accent);
	}
	:root[data-theme='light'] .pick[aria-pressed='true'] {
		background: var(--tw-mint-ink);
	}
	@media (pointer: coarse) {
		.pick {
			padding-block: 0.65rem;
		}
	}
	@media (max-width: 30rem) {
		.plot {
			grid-template-columns: 1fr;
		}
		.readout {
			grid-auto-flow: column;
			justify-content: start;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		h1:hover .ch {
			animation: none;
		}
	}
</style>
