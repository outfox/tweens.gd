---
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const facts = data.facts ?? [];
---

<div class="hero">
	<h1 id="_top" data-page-title>
		{/* The wordmark animates itself; its SVG honors reduced motion. */}
		<img src="/ferret-tweens.svg" alt={title} width="2003" height="996" fetchpriority="high" />
	</h1>
	{tagline && <p class="tagline" set:html={tagline} />}
	{
		data.heroDescription !== '' && (data.heroDescription ? (
			<p class="lede" set:html={data.heroDescription} />
		) : (
			data.description && <p class="lede">{data.description}</p>
		))
	}
	{
		facts.length > 0 && (
			<ul class="facts">
				{facts.map(({ text, link }) => (
					<li>{link ? <a href={link}>{text}</a> : text}</li>
				))}
			</ul>
		)
	}
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)
	}
</div>

<style>
	.hero {
		display: grid;
		gap: 1.4rem;
		justify-items: center;
		text-align: center;
		padding-block: clamp(1rem, 4vmin, 2.5rem) 2rem;
	}
	h1 {
		margin: 0 0 -0.4rem;
		width: min(100%, 50rem);
		line-height: 0;
	}
	h1 img {
		display: block;
		width: 100%;
		height: auto;
	}
	.tagline {
		margin: 0;
		max-width: 26ch;
		font-family: var(--tw-font-display);
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		line-height: 1.2;
		font-weight: 600;
		color: var(--tw-soft);
		text-wrap: balance;
	}
	.lede {
		margin: -0.4rem 0 0;
		max-width: 34rem;
		font-size: var(--sl-text-lg);
		line-height: 1.5;
		color: var(--tw-soft);
		text-wrap: pretty;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.facts li {
		margin: 0;
		padding: 0.2rem 0.7rem;
		border: 1px solid var(--tw-outline);
		border-radius: 999px;
		font: 500 var(--sl-text-xs) var(--sl-font-mono);
		color: var(--tw-soft);
	}
	/* Status links use the same amber accent as the sidebar badges. */
	.facts li:has(a) {
		border-color: color-mix(in oklab, var(--tw-amber) 55%, transparent);
		background: color-mix(in oklab, var(--tw-amber) 12%, transparent);
	}
	.facts a {
		color: var(--tw-amber-ink);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
		text-underline-offset: 0.2em;
	}
	.facts a:hover {
		text-decoration-color: currentColor;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.25rem;
		align-items: center;
	}
</style>
