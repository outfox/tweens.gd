---
import { Icon } from '@astrojs/starlight/components';
import logotype from '../../public/godot-logotype.svg?raw';

// Godot's lettering is inlined, so it renders as crisply as text and takes the text color.
const lettering = { viewBox: logotype.match(/viewBox="([^"]+)"/)![1], d: logotype.match(/\sd="([^"]+)"/)![1] };

// The language doors start the web simulation; the in-engine tutorial runs the same steps as a Godot project.
const doors = [
	{ lang: 'csharp', name: 'C#', requirements: 'Godot 4.7.2 .NET' },
	{ lang: 'gdscript', name: 'GDScript', requirements: 'Godot 4.7.2' },
];
---

<div class="tracks not-content tw-wide">
	<a class="engine" href="/tutorial/in-engine/">
		<span class="gutter" aria-hidden="true"></span>
		<span class="choice-copy">
			<span class="name">Start in…</span>
			<svg class="logotype" viewBox={lettering.viewBox} role="img" aria-label="Godot"><path d={lettering.d} /></svg>
			<span class="requirements">In-engine, Godot 4.7.2 .NET</span>
		</span>
		<span class="pitch">
			<span class="blurb">
				Download and open our interactive tutorial in the Godot editor. Each lesson comes as a C# and a GDScript
				scene, ready to run and edit.
			</span>
			<span class="cta">Get the tutorial project <Icon name="right-arrow" /></span>
		</span>
		<span class="gutter end" aria-hidden="true"></span>
		<span class="ribbon">The real deal!</span>
	</a>
	<div class="doors" id="choose-a-language" data-lang-switch data-shared role="group" aria-label="Tutorial language">
		{doors.map((d) => (
			<div class="door" data-door={d.lang}>
				<button class="start" type="button" data-lang-choice={d.lang} aria-describedby="language-hint">
					<span class="choice-copy">
						<span class="name">… or with {d.name}</span>
						<span class="requirements">{d.requirements}</span>
					</span>
					<span class="mode">(web simulation)</span>
					<span class="indicator" aria-hidden="true"><Icon name="check" /></span>
				</button>
			</div>
		))}
	</div>
</div>

<style>
	.tracks {
		container-type: inline-size;
		display: grid;
		gap: 1rem;
		margin-block: 1.5rem;
	}
	/* The primary choice takes a strong tint of the language accent. Its icon swings in at the left, faded and cropped
	   by the card, and hovering lifts the card and turns the icon a little further. */
	.engine {
		--tint: 28%;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: 1rem 2rem;
		min-height: 8.5rem;
		padding: 1.5rem;
		border: 1px solid color-mix(in oklab, var(--tw-accent) 70%, var(--tw-outline));
		border-radius: 1rem;
		background: linear-gradient(110deg, color-mix(in oklab, var(--tw-accent) var(--tint), var(--tw-stage)), var(--tw-stage) 75%);
		box-shadow: 0 14px 36px -24px var(--tw-accent);
		color: var(--sl-color-white);
		text-decoration: none;
		transition: border-color 0.2s, box-shadow 0.3s, translate 0.35s var(--ease-back-out);
	}
	:global(:root[data-theme='light']) .engine { --tint: 18%; }
	.engine::before {
		content: '';
		position: absolute;
		z-index: -1;
		top: 50%;
		left: -2rem;
		width: 18rem;
		aspect-ratio: 1;
		translate: 0 -50%;
		rotate: -20deg;
		background: url('/godot.svg') center / contain no-repeat;
		mask-image: radial-gradient(closest-side, #000 35%, transparent);
		opacity: 0.35;
		animation: godot-in 0.9s 0.1s var(--ease-back-out) backwards;
		transition: rotate 0.5s var(--ease-back-out), scale 0.5s var(--ease-back-out), opacity 0.2s;
	}
	/* The entrance moves transform and filter, which stack on the rotate, scale, and opacity that hovering transitions,
	   so a hover during the entrance blends in instead of cutting it off. */
	@keyframes godot-in {
		from { transform: rotate(-30deg) scale(0.8); filter: opacity(0); }
	}
	.engine:hover {
		translate: 0 -2px;
		border-color: var(--tw-accent);
		box-shadow: 0 18px 40px -20px var(--tw-accent);
	}
	.engine:hover::before {
		rotate: -12deg;
		scale: 1.06;
		opacity: 0.45;
	}
	.engine:focus-visible {
		outline: 2px solid var(--tw-accent-ink);
		outline-offset: 4px;
	}
	/* An outlined lead-in over Godot's own lettering, drawn in the text color so it suits either theme. */
	.engine .name {
		font: 900 2.75rem / 1.1 var(--tw-font-outline);
		letter-spacing: 0;
	}
	.logotype {
		display: block;
		width: 11rem;
		fill: currentColor;
	}
	/* A red band across the top right corner, centered on a point --inset in from each edge so its words clear the
	   rounded corner; the card clips the band's ends. */
	.ribbon {
		--inset: 3.6rem;
		position: absolute;
		top: calc(var(--inset) - 0.7rem);
		right: calc(var(--inset) - 8rem);
		width: 16rem;
		padding-block: 0.3rem;
		rotate: 45deg;
		background: #c62828;
		box-shadow: 0 3px 10px -4px rgb(0 0 0 / 0.5);
		color: #fff;
		font: 900 0.8rem / 1.2 var(--tw-font-display);
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}
	.pitch {
		display: grid;
		justify-items: start;
		gap: 0.9rem;
	}
	.blurb {
		max-width: 24rem;
		color: var(--tw-soft);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		text-wrap: pretty;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55em 0.8em 0.55em 1.1em;
		border-radius: 999px;
		background: var(--tw-accent-ink);
		box-shadow: 0 6px 16px -8px var(--tw-accent);
		color: var(--tw-on-accent);
		font-size: var(--sl-text-lg);
		font-weight: 900;
		transition: box-shadow 0.3s;
	}
	.cta :global(svg) {
		font-size: 1.25rem;
		transition: translate 0.35s var(--ease-back-out);
	}
	.engine:hover .cta { box-shadow: 0 10px 22px -8px var(--tw-accent); }
	.engine:hover .cta :global(svg) { translate: 3px 0; }
	.gutter { display: none; }
	/* A narrow card stacks the copy, and the band tucks further into the corner, clear of it. */
	@container (width < 40rem) {
		.ribbon { --inset: 2.9rem; font-size: 0.7rem; }
	}
	/* Side by side, the pitch takes the left and the title the right. The gutters prefer a fifth of the card each but
	   give way first when space runs short, before the pitch narrows; the end one keeps the title clear of the band. */
	@container (width >= 40rem) {
		.engine { display: flex; gap: 2rem; padding-inline: 0; }
		.gutter { display: block; flex: 0 1000 calc(20% - 2rem); }
		.gutter.end { order: 3; min-width: 4.5rem; }
		.pitch { order: 1; flex: 0 1 auto; min-width: 15rem; }
		.engine .choice-copy { order: 2; flex: none; justify-items: end; margin-inline-start: auto; text-align: end; }
	}
	.doors {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.door {
		container-type: inline-size;
		--choice-background: var(--tw-stage);
		--choice-border: var(--tw-outline);
		--choice-color: var(--sl-color-white);
		min-width: 0;
		border: 1px solid var(--choice-border);
		border-radius: 1rem;
		background: var(--choice-background);
		transition: border-color 0.2s, background-color 0.2s;
	}
	:global(:root:not([data-lang='gdscript'])) .door[data-door='csharp'],
	:global(:root[data-lang='gdscript']) .door[data-door='gdscript'] {
		--choice-background: var(--tw-accent-low);
		--choice-border: var(--tw-accent-ink);
		--choice-color: var(--tw-accent-ink);
		background-image: radial-gradient(ellipse at 0 0, color-mix(in oklab, var(--tw-accent) 22%, transparent), transparent 80%);
		box-shadow: 0 10px 28px -22px var(--tw-accent);
	}
	/* The mode sits at the right, beside the indicator, until the card gets too narrow; then it joins the copy. */
	.start {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 0.4rem 1rem;
		width: 100%;
		padding: 1.25rem;
		border: 0;
		border-radius: 1rem;
		background: transparent;
		color: var(--choice-color);
		font: inherit;
		text-align: start;
		cursor: pointer;
		transition: background-color 0.2s, color 0.2s;
	}
	.start:hover { background: color-mix(in oklab, var(--tw-accent) 8%, transparent); }
	.start:focus-visible {
		outline: 2px solid var(--tw-accent-ink);
		outline-offset: 4px;
	}
	.choice-copy { display: grid; gap: 0.4rem; }
	.name { font: 900 1.35rem / 1.25 var(--tw-font-display); }
	.requirements { color: var(--tw-soft); font-size: var(--sl-text-sm); line-height: 1.5; }
	.mode {
		color: var(--tw-muted);
		font-size: var(--sl-text-xs);
		white-space: nowrap;
	}
	@container (max-width: 26rem) {
		.start { grid-template-columns: minmax(0, 1fr) auto; }
		.mode { grid-area: 2 / 1; }
		.indicator { grid-area: 1 / 2 / span 2; }
	}
	.indicator {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		border: 1px solid var(--tw-muted);
		border-radius: 50%;
	}
	.indicator :global(svg) { opacity: 0; }
	.door:has([aria-pressed='true']) .indicator {
		background: var(--tw-accent-ink);
		border-color: var(--tw-accent-ink);
		color: var(--tw-on-accent);
	}
	.door:has([aria-pressed='true']) .indicator :global(svg) { opacity: 1; }
	@media (max-width: 36rem) {
		.tracks, .doors { gap: 0.75rem; }
		.doors { grid-template-columns: minmax(0, 1fr); }
		.engine { min-height: 0; padding: 1.25rem; }
		.engine .name { font-size: 2.25rem; }
		.logotype { width: 9rem; }
		.start { padding: 1rem 1.25rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.engine, .engine::before, .cta, .cta :global(svg), .door, .start { transition: none; }
		.engine::before { animation: none; }
	}
</style>
