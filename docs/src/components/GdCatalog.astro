---
// One page of the GDScript helper catalog (src/scripts/gd-catalog.ts): a class index, then one table per target class.
// The page names its section in the `catalog` frontmatter field, which the route middleware also reads for the table
// of contents; a `section` prop overrides it.
import { catalogSection } from '../scripts/gd-catalog';

interface Props {
	section?: string;
}
const section = Astro.props.section ?? Astro.locals.starlightRoute.entry.data.catalog;
const { targets, count, single, withProperty } = catalogSection(section);
const COLUMNS = withProperty ? ['Helper', 'Property', 'Value'] : ['Helper', 'Value'];
---

{
	!single && (
		<p>
			{count} helpers:{' '}
			{targets.map((t, i) => (
				<>
					{i > 0 && ' · '}
					<a href={`#${t.anchor}`}>{t.heading}</a>
				</>
			))}
		</p>
	)
}

{
	targets.map((target) => (
		<>
			{/* Matches the markup Starlight gives Markdown headings, anchor link included. */}
			{!single && (
				<div class="sl-heading-wrapper level-h2">
					<h2 id={target.anchor}>{target.heading}</h2>
					<a class="sl-anchor-link" href={`#${target.anchor}`}>
						<span aria-hidden="true" class="sl-anchor-icon">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
								<path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42" />
							</svg>
						</span>
						<span class="sr-only" data-pagefind-ignore>Section titled “{target.heading}”</span>
					</a>
				</div>
			)}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							{COLUMNS.map((c) => (
								<th scope="col">{c}</th>
							))}
						</tr>
					</thead>
					<tbody>
						{target.rows.map((row) => (
							<tr>
								<td data-label="Helper">
									<code>{row.helper}</code>
								</td>
								{withProperty && (
									<td data-label="Property">
										{row.property.map((path, i) => (
											<>
												{i > 0 && ', '}
												<code>{path}</code>
											</>
										))}
									</td>
								)}
								<td data-label="Value">{row.value}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</>
	))
}
