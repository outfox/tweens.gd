---
// The GDScript helper catalog, read from the addon's generated CATALOG.md at build time so the pages follow the addon.
// Rows are grouped by target class into the same sections as the C# catalog; unknown classes land under "Other".
// With a `section`, the component renders that section's page: a class index, then one table per target class.
import catalog from '../../../addons/tweens_gd/CATALOG.md?raw';

interface Props {
	section?: string;
}
const { section } = Astro.props;

interface Row {
	helper: string;
	csharp: string;
	target: string;
	value: string;
}

const cell = (text: string) => text.trim().replace(/^`|`$/g, '');
const rows: Row[] = catalog
	.split('\n')
	.filter((line) => line.startsWith('|') && !/^\|\s*(Helper|-)/.test(line))
	.map((line) => {
		const [helper, csharp, target, value] = line.split('|').slice(1, 5).map(cell);
		return { helper, csharp, target, value };
	})
	.filter((row) => row.helper && row.target);

const SECTIONS: [string, string[]][] = [
	[
		'2D',
		[
			'CanvasItem', 'Node2D', 'AnimatedSprite2D', 'Camera2D', 'CanvasLayer', 'CanvasModulate', 'CPUParticles2D',
			'GPUParticles2D', 'Light2D', 'Line2D', 'Parallax2D', 'PathFollow2D', 'PointLight2D', 'Polygon2D', 'Sprite2D',
		],
	],
	[
		'3D',
		[
			'Node3D', 'GeometryInstance3D', 'SpriteBase3D', 'AnimatedSprite3D', 'Camera3D', 'CPUParticles3D', 'Decal',
			'FogVolume', 'GPUParticles3D', 'Label3D', 'Light3D', 'OmniLight3D', 'PathFollow3D', 'SpotLight3D', 'SpringArm3D',
		],
	],
	['UI', ['Control', 'Range', 'ColorRect', 'Label', 'RichTextLabel', 'ScrollContainer', 'TextureProgressBar']],
	['Materials', ['BaseMaterial3D']],
	['Animation and audio', ['AnimationPlayer', 'AudioStreamPlayer', 'AudioStreamPlayer2D', 'AudioStreamPlayer3D']],
	['Any node', ['Node']],
];

const byTarget = Map.groupBy(rows, (row) => row.target);
const known = new Set(SECTIONS.flatMap(([, targets]) => targets));
const others = [...byTarget.keys()].filter((t) => !known.has(t)).sort();
const sections = [...SECTIONS, ['Other', others] as [string, string[]]]
	.map(([name, targets]) => [name, targets.filter((t) => byTarget.has(t))] as const)
	.filter(([name, targets]) => targets.length > 0 && (!section || name === section));
const shown = sections.flatMap(([, targets]) => targets);
const count = shown.reduce((n, t) => n + byTarget.get(t)!.length, 0);
// A page for one target class needs no index or class heading.
const single = shown.length === 1;

// Callback-only helpers target any Node; they read better under their own name.
const heading = (target: string) => (target === 'Node' ? 'Callback values' : target);
const anchor = (target: string) => heading(target).toLowerCase().replace(/\s+/g, '-');
const COLUMNS = ['Helper', 'C# definition', 'Value'];
---

{
	!single && (
		<p>
			{count} helpers:{' '}
			{shown.map((t, i) => (
				<>
					{i > 0 && ' · '}
					<a href={`#${anchor(t)}`}>{heading(t)}</a>
				</>
			))}
		</p>
	)
}

{
	shown.map((target) => (
		<>
			{!single && (
				<div class="sl-heading-wrapper level-h2">
					<h2 id={anchor(target)}>{heading(target)}</h2>
				</div>
			)}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							{COLUMNS.map((c) => (
								<th scope="col">{c}</th>
							))}
						</tr>
					</thead>
					<tbody>
						{byTarget.get(target)!.map((row) => (
							<tr>
								<td data-label={COLUMNS[0]}>
									<code>{row.helper}</code>
								</td>
								<td data-label={COLUMNS[1]}>
									<code>{row.csharp}</code>
								</td>
								<td data-label={COLUMNS[2]}>{row.value}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</>
	))
}
