---
import { FAMILIES, canonicalFamily } from '../scripts/motion';
import type { Lang } from '../scripts/lang';
interface Props { lang?: Lang }
const { lang = 'csharp' } = Astro.props;
const gd = lang === 'gdscript';
const sorted = FAMILIES.toSorted((a, b) => a.localeCompare(b, 'en'));
const curves = sorted.filter(f => !/\d$/.test(f));
const variants = sorted.filter(f => /\d$/.test(f));
---

<div class="tw-widget ep not-content" data-easing-playground data-code-lang={lang}>
	<div class="ep-heading"><span class="eyebrow">EASING COMPOSER</span><span class="badge">{new Set(FAMILIES.map(canonicalFamily)).size} × {new Set(FAMILIES.map(canonicalFamily)).size} curves</span></div>
	<div class="presets" aria-label="Easing presets">
		<button class="tw-btn" type="button" data-preset="Sine,Cubic">Soft landing</button>
		<button class="tw-btn" type="button" data-preset="Back,Bounce">Wind-up & bounce</button>
		<button class="tw-btn" type="button" data-preset="Sine,Elastic">Spring finish</button>
		<button class="tw-btn" type="button" data-preset="Sine,Sine">Sine in & out</button>
	</div>
	<div class="composer">
		<div class="visual">
			<svg class="graph" viewBox="0 0 496 296" role="img" aria-label="In, Out, and blended easing curves over time">
				<rect class="blend-zone" data-zone x="162" y="16" width="172" height="256" rx="8" />
				<path class="grid" data-value-grid d="M32 60H464M32 145H464M32 230H464M32 16V272M464 16V272" />
				<text x="12" y="64" data-value-tick="1">1</text><text x="4" y="149" data-value-tick="0.5">0.5</text><text x="12" y="234" data-value-tick="0">0</text>
				<text x="32" y="290">0 s</text><text x="464" y="290" text-anchor="end" data-end-time>1.2 s</text>
				<path class="source entry" data-entry />
				<path class="source exit" data-exit />
				<path class="result" data-curve />
				<line class="now" data-now x1="32" x2="32" y1="16" y2="272" />
				<circle class="tracer" data-tracer r="6" cx="32" cy="230" />
			</svg>
			<div class="legend"><span class="in-key">In half</span><span class="out-key">Out half</span><span class="result-key">Result</span><span class="zone-key">Join window</span></div>
			<svg class="lane" viewBox="0 0 496 48" aria-hidden="true">
				<path class="rail" data-rail d="M76 24H420" />
				{Array.from({length: 11}, () => <circle class="ghost" data-ghost cy="24" r="5" />)}
				<circle class="ball" data-ball cx="76" cy="24" r="10" />
			</svg>
			<svg class="velocity" viewBox="0 0 496 100" role="img" aria-label="Velocity over time">
				<text x="32" y="13">Velocity</text><text x="464" y="13" text-anchor="end" data-speed-scale />
				<path class="grid" data-speed-zero /><path class="result speed" data-speed />
			</svg>
			<label class="tw-field scrub"><span>Progress <output data-position-out>0.00 s · 0.000</output></span><input aria-label="Preview progress" type="range" min="0" max="1" step="0.001" value="0" data-progress /></label>
		</div>
		<div class="controls">
			<div class="selectors">
				<label class="tw-field"><span class="in-key">In curve</span><select data-in aria-label="In curve">
					<option value="None" selected>None (Out only)</option><hr />
					{curves.map(f => <option value={f}>{f}</option>)}<hr />
					{variants.map(f => <option value={f}>{f}</option>)}
				</select></label>
				<span class="join" aria-hidden="true">|</span>
				<label class="tw-field"><span class="out-key">Out curve</span><select data-out aria-label="Out curve">
					<option value="None">None (In only)</option><hr />
					{curves.map(f => <option value={f} selected={f === 'Elastic'}>{f}</option>)}<hr />
					{variants.map(f => <option value={f}>{f}</option>)}
				</select></label>
			</div>
			<label class="tw-field"><span>Duration <output data-duration-out>1.2 s</output></span><input type="range" min="0.2" max="4" step="0.1" value="1.2" data-duration /></label>
			<label class="tw-field"><span>Skew <output data-skew-out>1.00</output></span><input type="range" min="0.25" max="4" step="0.05" value="1" data-skew /></label>
			<label class="tw-field"><span>Join method</span><select data-blend aria-label="Join method"><option value="Hermite">Hermite · match velocity</option><option value="SmoothStep">SmoothStep · crossfade</option><option value="Linear">Linear · crossfade</option></select></label>
			<label class="tw-field"><span>Join width <output data-width-out>20%</output></span><input aria-label="Join width" type="range" min="0" max="1" step="0.02" value="0.2" data-width /></label>
			<p class="hint" data-hint>A single selected curve runs over the full duration. Choose both curves to join them.</p>
			<div class="buttons"><button type="button" class="tw-btn is-primary" data-play>Play</button><button type="button" class="tw-btn" data-reset>Reset</button></div>
		</div>
	</div>
	<div class="recipe">
		<pre>{gd ? (
			<code data-code><span class="kw">var</span> move = <span class="ty">Tweens</span>.<span class="fn">position_2d_x</span>(<span class="num">300.0</span>, <span class="num" data-code-duration>1.2</span>,
    <span data-code-ease><span class="ty">Tweens.Out</span>.ELASTIC</span>)
<span class="comment" data-code-option="skew"><span data-comment># </span>move.skew = <span class="num" data-code-skew>1.00</span></span>
<span class="comment" data-code-option="blend-type"><span data-comment># </span>move.blend_type = <span class="ty">Tweens.BlendType</span>.<span data-code-blend-type>HERMITE</span></span>
<span class="comment" data-code-option="blend"><span data-comment># </span>move.blend = <span class="num" data-code-blend>0.20</span></span>
<span class="ty">Tweens</span>.<span class="fn">play</span>(sprite, move)</code>
		) : (
			<code data-code>sprite.<span class="fn">TweenPositionX</span>(<span class="num">300</span>, <span class="num" data-code-duration>1.2</span>, options <span class="kw">=&gt;</span>
{'{'}
    options.Ease = <span data-code-ease><span class="ty">Out</span>.Elastic</span>;
    <span class="comment" data-code-option="skew"><span data-comment>// </span>options.Skew = <span class="num" data-code-skew>1.00</span>;</span>
    <span class="comment" data-code-option="blend-type"><span data-comment>// </span>options.BlendType = <span class="ty">BlendType</span>.<span data-code-blend-type>Hermite</span>;</span>
    <span class="comment" data-code-option="blend"><span data-comment>// </span>options.Blend = <span class="num" data-code-blend>0.20</span>;</span>
{'}'});</code>
		)}</pre>
		<button type="button" class="tw-btn" data-copy>Copy</button>
	</div>
	<p class="footnote">Time runs left to right. Rings mark equal time intervals; wider gaps mean faster motion. The velocity plot shows changes in speed and direction. Skew warps time before both curves and their join.</p>
	<span class="sr-only" role="status" aria-live="polite" data-announce></span>
</div>

<script>
	import { composeEase, legEase, pairedLegEase, canonicalFamily, type EaseLeg, type BlendType, tween, type TweenHandle } from '../scripts/motion';
	import { constant, langOf } from '../scripts/lang';
	for (const root of document.querySelectorAll<HTMLElement>('[data-easing-playground]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const entry = $<HTMLSelectElement>('[data-in]');
		const exit = $<HTMLSelectElement>('[data-out]');
		const duration = $<HTMLInputElement>('[data-duration]');
		const skew = $<HTMLInputElement>('[data-skew]');
		const progress = $<HTMLInputElement>('[data-progress]');
		const blend = $<HTMLSelectElement>('[data-blend]');
		const width = $<HTMLInputElement>('[data-width]');
		const playButton = $<HTMLButtonElement>('[data-play]');
		const gd = langOf(root) === 'gdscript';
		let playing: TweenHandle | undefined;
		let graphScale = 170, laneScale = 344;
		const graphY = (v: number) => 145 - graphScale * (v - 0.5);
		const laneX = (v: number) => 248 + laneScale * (v - 0.5);
		const value = (p: number) => composeEase(entry.value as EaseLeg, exit.value as EaseLeg, p, +skew.value, blend.value as BlendType, +width.value);
		const path = (f: (t: number) => number, start = 0, end = 1) => Array.from({length: 241}, (_, i) => {
			const t = start + (end - start) * i / 240;
			return `${i ? 'L' : 'M'}${(32 + 432 * t).toFixed(2)} ${(graphY(f(t))).toFixed(2)}`;
		}).join('');
		const draw = (p: number) => {
			const w = value(p), x = String(32 + 432 * p);
			$('[data-tracer]').setAttribute('cx', x);
			$('[data-tracer]').setAttribute('cy', String(graphY(w)));
			$('[data-now]').setAttribute('x1', x);
			$('[data-now]').setAttribute('x2', x);
			$('[data-ball]').setAttribute('cx', String(laneX(w)));
			progress.value = String(p);
			$('[data-position-out]').textContent = `${(p * +duration.value).toFixed(2)} s · ${w.toFixed(3)}`;
		};
		const stop = () => { playing?.cancel(); playing = undefined; playButton.textContent = 'Play'; };
		const update = () => {
			stop();
			const a = entry.value as EaseLeg, b = exit.value as EaseLeg, k = +skew.value;
			const matching = canonicalFamily(a) === canonicalFamily(b);
			// Keep the full overshoot and its motion preview visible, including the 50% curves.
			let extent = 0.5;
			for (let i = 0; i <= 1000; i++) {
				const t = i / 1000, u = t ** k;
				extent = Math.max(extent, Math.abs(value(t) - 0.5));
				if (a !== 'None' && (b === 'None' || u <= 0.5)) extent = Math.max(extent, Math.abs((b === 'None' ? legEase(a, 'In', u) : pairedLegEase(a, u)) - 0.5));
				if (b !== 'None' && (a === 'None' || u >= 0.5)) extent = Math.max(extent, Math.abs((a === 'None' ? legEase(b, 'Out', u) : pairedLegEase(b, u)) - 0.5));
			}
			graphScale = Math.min(170, 119 / extent);
			laneScale = Math.min(344, 214 / extent);
			$('[data-value-grid]').setAttribute('d', [0, 0.5, 1].map(v => `M32 ${graphY(v)}H464`).join('') + 'M32 16V272M464 16V272');
			root.querySelectorAll<SVGTextElement>('[data-value-tick]').forEach(tick => tick.setAttribute('y', String(graphY(+tick.dataset.valueTick!) + 4)));
			$('[data-rail]').setAttribute('d', `M${laneX(0)} 24H${laneX(1)}`);
			$('[data-curve]').setAttribute('d', path(value));
			$('[data-entry]').setAttribute('d', a === 'None' ? '' : path(t => b === 'None' ? legEase(a, 'In', t ** k) : pairedLegEase(a, t ** k), 0, b === 'None' ? 1 : 0.5 ** (1/k)));
			$('[data-exit]').setAttribute('d', b === 'None' ? '' : path(t => a === 'None' ? legEase(b, 'Out', t ** k) : pairedLegEase(b, t ** k), a === 'None' ? 0 : 0.5 ** (1/k), 1));
			const start = ((1 - +width.value)/2) ** (1 / k), end = ((1 + +width.value)/2) ** (1 / k);
			$('[data-zone]').setAttribute('x', String(32 + 432 * start));
			$('[data-zone]').setAttribute('width', String(a === 'None' || b === 'None' || matching ? 0 : 432 * (end - start)));
			$('[data-duration-out]').textContent = $<Element>('[data-end-time]').textContent = `${(+duration.value).toFixed(1)} s`;
			$('[data-skew-out]').textContent = k.toFixed(2);
			$('[data-width-out]').textContent = `${Math.round(+width.value*100)}%`;
			blend.disabled = width.disabled = a === 'None' || b === 'None' || matching;
			const velocities = Array.from({length: 241}, (_, i) => {
				const l = Math.max(0, (i-0.5)/240), r = Math.min(1, (i+0.5)/240);
				return (value(r)-value(l))/(r-l)/+duration.value;
			});
			const lo = Math.min(0, ...velocities), hi = Math.max(0.01, ...velocities);
			const sy = (v: number) => 88 - 62*(v-lo)/(hi-lo);
			$('[data-speed]').setAttribute('d', velocities.map((v,i) => `${i ? 'L' : 'M'}${32+432*i/240} ${sy(v)}`).join(''));
			$('[data-speed-zero]').setAttribute('d', `M32 ${sy(0)}H464`);
			$('[data-speed-scale]').textContent = `${lo.toFixed(1)} … ${hi.toFixed(1)} / s`;
			$('[data-hint]').textContent = a === 'None' || b === 'None'
				? 'A single selected curve runs over the full duration. Choose both curves to join them.'
				: matching ? `Matching ${a} legs use their paired profile directly.`
				: +width.value === 0 ? 'Direct splice at the midpoint. Different legs may meet with a velocity jump.'
				: `${blend.value === 'Hermite' ? 'Cubic join matches velocity' : blend.value + ' crossfades the family profiles'} from ${(start * 100).toFixed(0)}% to ${(end * 100).toFixed(0)}% of elapsed time.`;
			root.querySelectorAll('[data-ghost]').forEach((g, i) => g.setAttribute('cx', String(laneX(value(i / 10)))));
			const name = (leg: string, family: string): (Node | string)[] => {
				const type = document.createElement('span');
				type.className = 'ty';
				type.textContent = gd ? `Tweens.${leg}` : leg;
				return [type, `.${gd ? constant(family) : family}`];
			};
			const expression = matching && a !== 'None' ? name('InOut', a)
				: a === 'None' ? name('Out', b) : b === 'None' ? name('In', a) : [...name('In', a), ' | ', ...name('Out', b)];
			$('[data-code-ease]').replaceChildren(...expression);
			$('[data-code-duration]').textContent = (+duration.value).toFixed(1);
			$('[data-code-skew]').textContent = k.toFixed(2);
			$('[data-code-blend-type]').textContent = gd ? constant(blend.value) : blend.value;
			$('[data-code-blend]').textContent = (+width.value).toFixed(2);
			root.querySelectorAll<HTMLElement>('[data-code-option]').forEach(line => {
				const commented = line.dataset.codeOption === 'skew' ? k === 1
					: blend.disabled || (line.dataset.codeOption === 'blend' && +width.value === 0.2);
				line.classList.toggle('comment', commented);
				line.querySelector('[data-comment]')!.textContent = commented ? (gd ? '# ' : '// ') : '';
			});
			root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.preset === `${a},${b}`)));
			draw(+progress.value);
		};
		playButton.addEventListener('click', () => {
			if (playing) { stop(); return; }
			const handle = tween(+duration.value, (_, p) => draw(p), 'Linear');
			playing = handle;
			playButton.textContent = 'Stop';
			handle.completion.then(() => { if (playing === handle) { playing = undefined; playButton.textContent = 'Play'; } });
		});
		for (const input of [entry, exit, duration, skew, blend, width]) input.addEventListener('input', update);
		progress.addEventListener('input', () => { stop(); draw(+progress.value); });
		root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button => button.addEventListener('click', () => {
			[entry.value, exit.value] = button.dataset.preset!.split(','); update();
		}));
		$('[data-reset]').addEventListener('click', () => { entry.value = 'None'; exit.value = 'Elastic'; duration.value = '1.2'; skew.value = '1'; blend.value = 'Hermite'; width.value = '0.2'; progress.value = '0'; update(); });
		$('[data-copy]').addEventListener('click', async () => {
			try { await navigator.clipboard.writeText($('[data-code]').textContent!); $<Element>('[data-announce]').textContent = 'Tween code copied.'; }
			catch { $<Element>('[data-announce]').textContent = 'Select the code to copy it.'; }
		});
		update();
	}
</script>

<style>
	.ep { padding: 1.25rem; display: grid; gap: 1.25rem; }
	.ep-heading, .buttons, .presets, .legend { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
	.ep-heading { justify-content: space-between; }
	.eyebrow { font: 600 .75rem var(--sl-font-mono); letter-spacing: .13em; color: var(--tw-mint-ink); }
	.badge { color: var(--tw-muted); font: .75rem var(--sl-font-mono); }
	.presets .tw-btn { font-size: .8rem; }
	.presets [aria-pressed='true'] { background: var(--tw-selected); border-color: var(--tw-mint); }
	.composer { display: grid; gap: 1.5rem; }
	.visual { min-width: 0; }
	.graph, .lane, .velocity { display: block; width: 100%; overflow: hidden; }
	.graph { background: var(--tw-stage); border-radius: .75rem; }
	.graph text, .velocity text { fill: var(--tw-muted); font: 11px var(--sl-font-mono); }
	.blend-zone { fill: var(--tw-mint); opacity: .08; }
	.grid { fill: none; stroke: var(--tw-grid); stroke-dasharray: 3 5; }
	.source, .result { fill: none; stroke-linecap: round; stroke-linejoin: round; }
	.source { stroke-width: 1.6; opacity: .8; }
	.entry { stroke: var(--tw-amber); stroke-dasharray: 7 5; }
	.exit { stroke: var(--tw-blue); stroke-dasharray: 2 4; }
	.result { stroke: var(--tw-mint); stroke-width: 3; }
	.speed { stroke-width: 2; opacity: .8; }
	.now { stroke: var(--tw-muted); stroke-dasharray: 2 4; opacity: .5; }
	.tracer { fill: var(--tw-stage); stroke: var(--tw-mint); stroke-width: 3; }
	.legend { justify-content: center; gap: 1rem; font-size: .75rem; margin-top: .65rem; }
	.in-key { color: var(--tw-amber-ink); }
	.out-key { color: var(--tw-blue-ink); }
	.result-key { color: var(--tw-mint-ink); }
	.zone-key { color: var(--tw-muted); }
	.rail { stroke: var(--tw-outline); stroke-width: 2; stroke-dasharray: 2 5; }
	.ghost { fill: none; stroke: var(--tw-mint); opacity: .5; }
	.ball { fill: var(--tw-mint); }
	.controls { display: grid; align-content: start; gap: 1.25rem; }
	.selectors { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: .5rem; align-items: end; }
	.join { font: 1.25rem var(--sl-font-mono); color: var(--tw-muted); padding-bottom: .4rem; }
	select { width: 100%; min-width: 0; color: var(--tw-text); background: var(--tw-stage); border: 1px solid var(--tw-outline); border-radius: .5rem; padding: .65rem .4rem; font: .85rem var(--sl-font-mono); }
	select:focus-visible { outline: 2px solid var(--tw-mint); outline-offset: 2px; }
	.hint, .footnote { color: var(--tw-muted); font-size: .8rem; line-height: 1.6; margin: 0; }
	.recipe { display: flex; gap: .75rem; align-items: start; background: var(--tw-stage); border: 1px solid var(--tw-outline); border-radius: .75rem; padding: 1rem; }
	.recipe pre { flex: 1; min-width: 0; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .78rem; color: var(--tw-soft); }
	.recipe :global(.kw) { color: var(--tw-blue-ink); }
	.recipe :global(.ty) { color: var(--tw-mint-ink); }
	.recipe :global(.fn), .recipe :global(.num) { color: var(--tw-amber-ink); }
	.recipe :global(.comment), .recipe :global(.comment *) { color: var(--tw-muted); }
	.recipe .tw-btn { font-size: .75rem; }
	.scrub { font-size: .8rem; }
	@media (min-width: 50rem) { .composer { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
	@media (max-width: 30rem) { .ep { padding: .8rem; } .recipe { flex-direction: column; } }
</style>
