---
import { FAMILIES, canonicalFamily } from '../scripts/motion';
import type { Lang } from '../scripts/lang';
interface Props { lang?: Lang }
const { lang = 'csharp' } = Astro.props;
const gd = lang === 'gdscript';
const sorted = FAMILIES.toSorted((a, b) => a.localeCompare(b, 'en'));
const curves = sorted.filter(f => !/\d$/.test(f));
const variants = sorted.filter(f => /\d$/.test(f));
---

<div class="tw-widget ep not-content" data-easing-playground data-code-lang={lang}>
	<div class="ep-heading"><span class="eyebrow">EASING PLAYGROUND</span><span class="badge">{new Set(FAMILIES.map(canonicalFamily)).size} × {new Set(FAMILIES.map(canonicalFamily)).size} curves</span><button type="button" class="tw-btn" data-reset>Reset</button></div>
	<div class="composer">
		<div class="visual">
			<svg class="graph" viewBox="0 0 496 296" role="img" aria-label="In, Out, and blended easing curves over time">
				<rect class="blend-zone" data-zone x="162" y="16" width="172" height="256" rx="8" />
				<path class="grid" data-value-grid d="M32 60H464M32 145H464M32 230H464M32 16V272M464 16V272" />
				<text x="12" y="64" data-value-tick="1">1</text><text x="4" y="149" data-value-tick="0.5">0.5</text><text x="12" y="234" data-value-tick="0">0</text>
				<text x="32" y="290">0 s</text><text x="464" y="290" text-anchor="end" data-end-time>2.0 s</text>
				<path class="result" data-curve />
				<path class="source entry" data-entry />
				<path class="source exit" data-exit />
				<line class="now" data-now x1="32" x2="32" y1="16" y2="272" />
				<circle class="tracer" data-tracer r="6" cx="32" cy="230" />
			</svg>
			<div class="legend"><span class="in-key">In half</span><span class="out-key">Out half</span><span class="result-key">Result</span><span class="zone-key">Blend window</span></div>
			<div class="transport">
				<button type="button" class="tw-btn is-primary play" data-play>
					<svg class="play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" /></svg>
					<svg class="stop-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="3" width="10" height="10" rx="1.5" /></svg>
					<span data-play-label>Play</span>
				</button>
				<div class="preview" aria-hidden="true">
					<span class="rail" data-rail></span>
					{Array.from({length: 11}, () => <span class="ghost" data-ghost />)}
					<span class="ball" data-ball></span>
				</div>
				<output class="value-out" data-value-out>0.000</output>
				<input class="scrub" aria-label="Preview progress" type="range" min="0" max="1" step="0.001" value="0" data-progress />
				<output class="time-out" data-time-out>0.00 s</output>
			</div>
		</div>
		<div class="controls">
			<div class="selectors">
				<label class="tw-field"><span class="in-key">In curve</span><select data-in aria-label="In curve">
					<option value="None" selected>None (Out only)</option><hr />
					{curves.map(f => <option value={f}>{f}</option>)}<hr />
					{variants.map(f => <option value={f}>{f}</option>)}
				</select></label>
				<span class="join" aria-hidden="true">|</span>
				<label class="tw-field"><span class="out-key">Out curve</span><select data-out aria-label="Out curve">
					<option value="None">None (In only)</option><hr />
					{curves.map(f => <option value={f} selected={f === 'Elastic'}>{f}</option>)}<hr />
					{variants.map(f => <option value={f}>{f}</option>)}
				</select></label>
			</div>
			<label class="tw-field"><span>Duration <output data-duration-out>2.0 s</output></span><input type="range" min="0.2" max="5" step="0.1" value="2" data-duration /></label>
			<label class="tw-field"><span>Skew <output data-skew-out>1.00</output></span><input type="range" min="0.25" max="4" step="0.05" value="1" data-skew /></label>
			<label class="tw-field"><span>Blend type</span><select data-blend aria-label="Blend type"><option value="Makima">Makima · match velocity</option><option value="Hermite">Hermite · match acceleration</option><option value="SmoothStep">SmoothStep · crossfade</option><option value="Linear">Linear · crossfade</option></select></label>
			<label class="tw-field"><span>Blend &nbsp;<output data-width-out>20%</output></span><input aria-label="Blend" type="range" min="0" max="1" step="0.02" value="0.2" data-width /></label>
		</div>
	</div>
	<div class="recipe">
		<div class="recipe-bar"><span class="hint">Source code recipe for this curve</span><button type="button" class="tw-btn" data-copy>Copy</button></div>
		<pre>{gd ? (
			<code data-code><span class="kw">var</span> move = <span class="ty">Tweens</span>.<span class="fn">position_2d_x</span>(<span class="num">300.0</span>, <span class="num" data-code-duration>2.0</span>, <span data-code-ease><span class="ty">Out</span>.ELASTIC</span>)<span data-code-option="skew" hidden>
move.skew = <span class="num" data-code-skew>1.00</span></span><span data-code-option="blend-type" hidden>
move.blend_type = <span class="ty">BlendType</span>.<span data-code-blend-type>MAKIMA</span></span><span data-code-option="blend" hidden>
move.blend = <span class="num" data-code-blend>0.20</span></span>
<span class="ty">Tweens</span>.<span class="fn">play</span>(sprite, move)</code>
		) : (
			<code data-code><span class="kw">var</span> move = <span class="kw">new</span> <span class="ty">Tweens</span>.<span class="ty">Position2DX</span>
{'{'}
    Duration = <span class="num" data-code-duration>2.0</span>,
    Ease = <span data-code-ease><span class="ty">Out</span>.Elastic</span>,<span data-code-option="skew" hidden>
    Skew = <span class="num" data-code-skew>1.00</span>,</span><span data-code-option="blend-type" hidden>
    BlendType = <span class="ty">BlendType</span>.<span data-code-blend-type>Makima</span>,</span><span data-code-option="blend" hidden>
    Blend = <span class="num" data-code-blend>0.20</span>,</span>
{'}'};
sprite.<span class="fn">Tween</span>(move <span class="kw">with</span> {'{'} To = <span class="num">300</span> {'}'});</code>
		)}</pre>
	</div>
	<span class="sr-only" role="status" aria-live="polite" data-announce></span>
</div>

<script>
	import { composeEase, legEase, pairedLegEase, canonicalFamily, type EaseLeg, type BlendType, tween, type TweenHandle } from '../scripts/motion';
	import { constant, langOf } from '../scripts/lang';
	for (const root of document.querySelectorAll<HTMLElement>('[data-easing-playground]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const entry = $<HTMLSelectElement>('[data-in]');
		const exit = $<HTMLSelectElement>('[data-out]');
		const duration = $<HTMLInputElement>('[data-duration]');
		const skew = $<HTMLInputElement>('[data-skew]');
		const progress = $<HTMLInputElement>('[data-progress]');
		const blend = $<HTMLSelectElement>('[data-blend]');
		const width = $<HTMLInputElement>('[data-width]');
		const playButton = $<HTMLButtonElement>('[data-play]');
		const gd = langOf(root) === 'gdscript';
		let playing: TweenHandle | undefined;
		let graphScale = 170, laneScale = 1;
		const graphY = (v: number) => 145 - graphScale * (v - 0.5);
		// Fraction of the preview width, matching the progress thumb when nothing overshoots.
		const laneX = (v: number) => String(0.5 + laneScale * (v - 0.5));
		const value = (p: number) => composeEase(entry.value as EaseLeg, exit.value as EaseLeg, p, +skew.value, blend.value as BlendType, +width.value);
		const path = (f: (t: number) => number, start = 0, end = 1) => Array.from({length: 241}, (_, i) => {
			const t = start + (end - start) * i / 240;
			return `${i ? 'L' : 'M'}${(32 + 432 * t).toFixed(2)} ${(graphY(f(t))).toFixed(2)}`;
		}).join('');
		const draw = (p: number) => {
			const w = value(p), x = String(32 + 432 * p);
			$('[data-tracer]').setAttribute('cx', x);
			$('[data-tracer]').setAttribute('cy', String(graphY(w)));
			$('[data-now]').setAttribute('x1', x);
			$('[data-now]').setAttribute('x2', x);
			$<HTMLElement>('[data-ball]').style.setProperty('--x', laneX(w));
			progress.value = String(p);
			$('[data-time-out]').textContent = `${(p * +duration.value).toFixed(2)} s`;
			$('[data-value-out]').textContent = w.toFixed(3);
		};
		const setPlaying = (handle?: TweenHandle) => {
			playing = handle;
			playButton.classList.toggle('is-playing', !!handle);
			$('[data-play-label]').textContent = handle ? 'Stop' : 'Play';
		};
		const stop = () => { playing?.cancel(); setPlaying(); };
		const update = () => {
			stop();
			const a = entry.value as EaseLeg, b = exit.value as EaseLeg, k = +skew.value;
			const matching = canonicalFamily(a) === canonicalFamily(b);
			// Keep the full overshoot and its motion preview visible, including the 50% curves.
			let extent = 0.5, reach = 0.5;
			for (let i = 0; i <= 1000; i++) {
				const t = i / 1000, u = t ** k;
				reach = Math.max(reach, Math.abs(value(t) - 0.5));
				if (a !== 'None' && (b === 'None' || u <= 0.5)) extent = Math.max(extent, Math.abs((b === 'None' ? legEase(a, 'In', u) : pairedLegEase(a, u)) - 0.5));
				if (b !== 'None' && (a === 'None' || u >= 0.5)) extent = Math.max(extent, Math.abs((a === 'None' ? legEase(b, 'Out', u) : pairedLegEase(b, u)) - 0.5));
			}
			graphScale = Math.min(170, 119 / Math.max(extent, reach));
			laneScale = 0.5 / reach;
			$('[data-value-grid]').setAttribute('d', [0, 0.5, 1].map(v => `M32 ${graphY(v)}H464`).join('') + 'M32 16V272M464 16V272');
			root.querySelectorAll<SVGTextElement>('[data-value-tick]').forEach(tick => tick.setAttribute('y', String(graphY(+tick.dataset.valueTick!) + 4)));
			$<HTMLElement>('[data-rail]').style.setProperty('--x', laneX(0));
			$<HTMLElement>('[data-rail]').style.setProperty('--to', laneX(1));
			$('[data-curve]').setAttribute('d', path(value));
			$('[data-entry]').setAttribute('d', a === 'None' ? '' : path(t => b === 'None' ? legEase(a, 'In', t ** k) : pairedLegEase(a, t ** k), 0, b === 'None' ? 1 : 0.5 ** (1/k)));
			$('[data-exit]').setAttribute('d', b === 'None' ? '' : path(t => a === 'None' ? legEase(b, 'Out', t ** k) : pairedLegEase(b, t ** k), a === 'None' ? 0 : 0.5 ** (1/k), 1));
			const start = ((1 - +width.value)/2) ** (1 / k), end = ((1 + +width.value)/2) ** (1 / k);
			$('[data-zone]').setAttribute('x', String(32 + 432 * start));
			$('[data-zone]').setAttribute('width', String(a === 'None' || b === 'None' || matching ? 0 : 432 * (end - start)));
			$('[data-duration-out]').textContent = $<Element>('[data-end-time]').textContent = `${(+duration.value).toFixed(1)} s`;
			$('[data-skew-out]').textContent = k.toFixed(2);
			$('[data-width-out]').textContent = `${Math.round(+width.value*100)}%`;
			blend.disabled = width.disabled = a === 'None' || b === 'None' || matching;
			root.querySelectorAll<HTMLElement>('[data-ghost]').forEach((g, i) => g.style.setProperty('--x', laneX(value(i / 10))));
			const name = (leg: string, family: string): (Node | string)[] => {
				const type = document.createElement('span');
				type.className = 'ty';
				type.textContent = leg;
				return [type, `.${gd ? constant(family) : family}`];
			};
			const expression = matching && a !== 'None' ? name('InOut', a)
				: a === 'None' ? name('Out', b) : b === 'None' ? name('In', a) : [...name('In', a), ' | ', ...name('Out', b)];
			$('[data-code-ease]').replaceChildren(...expression);
			$('[data-code-duration]').textContent = (+duration.value).toFixed(1);
			$('[data-code-skew]').textContent = k.toFixed(2);
			$('[data-code-blend-type]').textContent = gd ? constant(blend.value) : blend.value;
			$('[data-code-blend]').textContent = (+width.value).toFixed(2);
			root.querySelectorAll<HTMLElement>('[data-code-option]').forEach(line => {
				// Options at their defaults are left out.
				const option = line.dataset.codeOption;
				line.hidden = option === 'skew' ? k === 1
					: blend.disabled || (option === 'blend-type' && blend.value === 'Makima') || (option === 'blend' && +width.value === 0.2);
			});
			draw(+progress.value);
		};
		playButton.addEventListener('click', () => {
			if (playing) { stop(); return; }
			const handle = tween(+duration.value, (_, p) => draw(p), 'Linear');
			setPlaying(handle);
			handle.completion.then(() => { if (playing === handle) setPlaying(); });
		});
		for (const input of [entry, exit, duration, skew, blend, width]) input.addEventListener('input', update);
		progress.addEventListener('input', () => { stop(); draw(+progress.value); });
		$('[data-reset]').addEventListener('click', () => { entry.value = 'None'; exit.value = 'Elastic'; duration.value = '2'; skew.value = '1'; blend.value = 'Makima'; width.value = '0.2'; progress.value = '0'; update(); });
		$('[data-copy]').addEventListener('click', async () => {
			try { await navigator.clipboard.writeText($<HTMLElement>('[data-code]').innerText); $<Element>('[data-announce]').textContent = 'Tween code copied.'; }
			catch { $<Element>('[data-announce]').textContent = 'Select the code to copy it.'; }
		});
		update();
	}
</script>

<style>
	.ep { padding: 1.25rem; display: grid; gap: 1.25rem; }
	.ep-heading, .legend { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
	.eyebrow { font: 600 .75rem var(--sl-font-mono); letter-spacing: .13em; color: var(--tw-accent-ink); }
	.badge { margin-left: auto; color: var(--tw-muted); font: .75rem var(--sl-font-mono); }
	.ep-heading .tw-btn { min-height: 1.9rem; font-size: .75rem; }
	.composer { display: grid; gap: 1.5rem; }
	.visual { min-width: 0; }
	.graph { display: block; width: 100%; overflow: hidden; background: var(--tw-stage); border-radius: .75rem; }
	.graph text { fill: var(--tw-muted); font: 11px var(--sl-font-mono); }
	.blend-zone { fill: var(--tw-mint); opacity: .08; }
	.grid { fill: none; stroke: var(--tw-grid); stroke-dasharray: 3 5; }
	.source, .result { fill: none; stroke-linecap: round; stroke-linejoin: round; }
	.source { stroke-width: 1.6; opacity: .8; }
	.entry { stroke: var(--tw-amber); stroke-dasharray: 7 5;  stroke-width: 3; }
	.exit { stroke: var(--tw-blue); stroke-dasharray: 2 4; stroke-width: 3; }
	.result { stroke: color-mix(in oklab, var(--tw-mint) 60%, black); stroke-width: 12; }
	.now { stroke: var(--tw-muted); stroke-dasharray: 2 4; opacity: .5; }
	.tracer { fill: var(--tw-stage); stroke: var(--tw-mint); stroke-width: 3; }
	.legend { justify-content: center; gap: 1rem; font-size: .75rem; margin-top: .4rem; }
	.in-key { color: var(--tw-amber-ink); }
	.out-key { color: var(--tw-blue-ink); }
	.result-key { color: var(--tw-mint-ink); }
	.zone-key { color: var(--tw-muted); }
	/* The preview sits on the progress track, so the ball starts and ends under the thumb. */
	.transport { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'play preview value' 'play scrub time'; align-items: center; column-gap: 1rem; margin-top: 1.25rem; }
	.play { grid-area: play; min-height: 3rem; padding: .5rem 1.4rem .5rem 1.1rem; font-size: var(--sl-text-base); box-shadow: 0 .4rem 1.2rem color-mix(in oklab, var(--tw-accent) 25%, transparent); }
	.play svg { fill: currentColor; }
	.play .stop-icon, .play.is-playing .play-icon { display: none; }
	.play.is-playing .stop-icon { display: block; }
	.preview { grid-area: preview; position: relative; height: 1.75rem; --pad: .5rem; }
	.preview > * { position: absolute; top: 50%; left: calc(var(--pad) + (100% - 2 * var(--pad)) * var(--x, 0)); translate: -50% -50%; border-radius: 50%; }
	.rail { translate: -1px -50%; width: calc((100% - 2 * var(--pad)) * (var(--to, 1) - var(--x, 0))); height: .75rem; border-radius: 0; border-inline: 2px solid color-mix(in oklab, var(--tw-muted) 60%, transparent); background: radial-gradient(circle, var(--tw-outline) 1px, transparent 1.5px) center / 7px 4px repeat-x; }
	.ghost { width: .6rem; height: .6rem; border: 1.5px solid var(--tw-mint); opacity: .5; }
	.ball { width: 1.25rem; height: 1.25rem; background: var(--tw-mint); }
	.scrub { grid-area: scrub; width: 100%; margin: 0; }
	.transport output { min-width: 6ch; font: .75rem var(--sl-font-mono); color: var(--tw-muted); text-align: right; }
	.value-out { grid-area: value; }
	.time-out { grid-area: time; }
	.controls { display: grid; align-content: start; gap: 1.25rem; }
	.selectors { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: .5rem; align-items: end; }
	.join { font: 1.25rem var(--sl-font-mono); color: var(--tw-muted); padding-bottom: .4rem; }
	select { width: 100%; min-width: 0; color: var(--tw-text); background: var(--tw-stage); border: 1px solid var(--tw-outline); border-radius: .5rem; padding: .65rem .4rem; font: .85rem var(--sl-font-mono); }
	/* Blend controls only apply when two different curves meet. */
	.tw-field:has(:disabled) { opacity: .5; }
	.tw-field :disabled { cursor: not-allowed; }
	select:focus-visible { outline: 2px solid var(--tw-accent); outline-offset: 2px; }
	.recipe { background: var(--tw-code-bg); border: 1px solid var(--tw-outline); border-radius: .75rem; overflow: hidden; }
	.recipe-bar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .4rem .5rem .4rem 1rem; border-bottom: 1px solid var(--tw-outline); }
	.hint { color: var(--tw-muted); font-size: .8rem; }
	.recipe-bar .tw-btn { min-height: 1.9rem; font-size: .75rem; }
	.recipe pre { margin: 0; padding: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .85rem; line-height: 1.6; color: var(--tw-soft); }
	.recipe :global(.kw) { color: var(--tw-blue-ink); }
	.recipe :global(.ty) { color: var(--tw-mint-ink); }
	.recipe :global(.fn), .recipe :global(.num) { color: var(--tw-amber-ink); }
	@media (min-width: 50rem) { .composer { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
	@media (max-width: 30rem) {
		.ep { padding: .8rem; }
		.transport { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'preview value' 'scrub time' 'play play'; row-gap: .5rem; }
		.play { justify-self: start; }
	}
</style>
