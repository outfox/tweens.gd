---
// A Tweens.FX effect at its default settings: the Godot icon moves with it beside a plot of its offset over one play.
// Plot and animation share scripts/effect-preview.ts, which samples the docs' port of FX.cs (tested by check:easing).
import type { Lang } from '../scripts/lang';
import { PLOT, plotPoint, plotY, type Effect } from '../scripts/effect-preview';

interface Props {
	effect: Effect;
	lang?: Lang;
}
const { effect, lang = 'csharp' } = Astro.props;

const call = `Tweens.FX.${lang === 'gdscript' ? effect : effect[0].toUpperCase() + effect.slice(1)}()`;
let d = '';
for (let i = 0; i <= 240; i++) {
	const [x, y] = plotPoint(effect, i / 240);
	d += `${i ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`;
}
---

<figure class="fx not-content" data-fx={effect}>
	<div class="stage" aria-hidden="true">
		<span class="sprite" data-sprite></span>
	</div>
	<svg class="plot" viewBox={`0 0 ${PLOT.width} ${PLOT.height}`} preserveAspectRatio="none" aria-hidden="true">
		<path class="zero" d={`M0 ${plotY(effect, 0)}H${PLOT.width}`} />
		<path class="curve" d={d} />
		<line class="playhead" data-playhead y1="0" y2={PLOT.height} />
		<path class="head" data-head d="M0 0h0" />
	</svg>
	<figcaption><code>{call}</code></figcaption>
</figure>

<script>
	import { loop } from '../scripts/motion';
	import { PREVIEWS, plotPoint, type Effect } from '../scripts/effect-preview';

	for (const figure of document.querySelectorAll<HTMLElement>('[data-fx]')) {
		const effect = figure.dataset.fx as Effect;
		const { play, rest, pose } = PREVIEWS[effect];
		const sprite = figure.querySelector<HTMLElement>('[data-sprite]')!;
		const playhead = figure.querySelector<SVGLineElement>('[data-playhead]')!;
		const head = figure.querySelector<SVGPathElement>('[data-head]')!;
		// Each preview starts at rest, which is also its still frame under reduced motion.
		loop(figure, (seconds) => {
			const time = seconds % (play + rest);
			const playing = time < play;
			const t = playing ? time / play : 1;
			const [x, y, scale] = pose(t);
			sprite.style.translate = `${x}px ${y}px`;
			sprite.style.scale = String(scale);
			const [px, py] = plotPoint(effect, t);
			playhead.setAttribute('x1', String(px));
			playhead.setAttribute('x2', String(px));
			head.setAttribute('d', `M${px} ${py}h0`);
			figure.classList.toggle('is-resting', !playing);
		}, play);
	}
</script>

<style>
	/* The three previews sit side by side where there is room. */
	:global(.card-grid:has(.fx)) {
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
	}
	.fx {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
	}
	.stage,
	.plot {
		border-radius: 0.6rem;
		background: var(--tw-stage);
	}
	.stage {
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.sprite {
		width: 2rem;
		height: 2rem;
		background: url('/godot.svg') center / contain no-repeat;
		filter: drop-shadow(0 2px 4px rgb(3 8 14 / 0.35));
	}
	.plot {
		display: block;
		width: 100%;
		height: 4.5rem;
	}
	.zero {
		fill: none;
		stroke: var(--tw-outline);
		stroke-dasharray: 2 2;
		vector-effect: non-scaling-stroke;
	}
	.curve {
		fill: none;
		stroke: var(--tw-accent);
		stroke-width: 1.5;
		stroke-linejoin: round;
		opacity: 0.75;
		vector-effect: non-scaling-stroke;
	}
	.playhead {
		stroke: var(--tw-outline);
		vector-effect: non-scaling-stroke;
	}
	/* A zero-length, round-capped path stays a circle in the stretched plot. */
	.head {
		stroke: var(--tw-accent);
		stroke-width: 7;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}
	:global(:root[data-theme='light']) .curve {
		stroke: var(--tw-accent-ink);
	}
	:global(:root[data-theme='light']) .head {
		stroke: var(--tw-accent-ink);
	}
	.playhead,
	.head {
		transition: opacity 0.25s;
	}
	.is-resting :is(.playhead, .head) {
		opacity: 0;
	}
	figcaption {
		grid-column: 1 / -1;
		font: var(--sl-text-2xs) var(--sl-font-mono);
		color: var(--tw-muted);
	}
</style>
