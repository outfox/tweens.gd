---
// C# | GDScript. On a language page each option links to the same page in that language's path.
// On a shared page it switches the language the page's examples use and remembers it (see Head.astro).
import { LANGS, firstSlug, slugOf, trackOf } from '../tracks.mjs';

const { id } = Astro.locals.starlightRoute;
const track = trackOf(id);
const slug = track ? slugOf(id) : firstSlug;
---

<nav class="lang-switch" aria-label="Language" data-lang-switch data-shared={track ? undefined : ''}>
	{
		Object.entries(LANGS).map(([lang, { label }]) => (
			<a href={`/${lang}/${slug}/`} data-lang-choice={lang} aria-current={track === lang ? 'page' : undefined}>
				{label}
			</a>
		))
	}
</nav>

<script>
	const KEY = 'tweens-lang';
	const root = document.documentElement;

	// Where an anchor link leaves its heading: below the nav bar, at Starlight's scroll padding.
	const readingLine = () => parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
	const top = (el: Element) => el.getBoundingClientRect().top;

	/** The reader's section at the reading line, as the h3 then its h2, each with how far through it they are. */
	const place = () => {
		const content = document.querySelector('.sl-markdown-content');
		if (!content) return [];
		const all = [...content.querySelectorAll<HTMLElement>('.sl-heading-wrapper > :is(h2, h3)')];
		const rank = (h: Element) => Number(h.tagName[1]);
		const line = readingLine();
		const current = all.filter((h) => top(h) <= line + 2).pop();
		if (!current) return [];
		const sections = [current];
		if (rank(current) === 3) {
			const h2 = all.slice(0, all.indexOf(current)).filter((h) => rank(h) === 2).pop();
			if (h2) sections.push(h2);
		}
		return sections.map((h) => {
			const level = rank(h);
			const same = all.filter((x) => rank(x) === level);
			const next = all.slice(all.indexOf(h) + 1).find((x) => rank(x) <= level);
			const span = (next ? top(next) : content.getBoundingClientRect().bottom) - top(h);
			const share = span > 0 ? Math.min(1, Math.max(0, (line - top(h)) / span)) : 0;
			return { id: h.id, level, index: same.indexOf(h), count: same.length, share };
		});
	};

	// Language pages: each choice links to the twin page. A plain click hands the twin the reader's place, the
	// sidebar scroll, and the language to slide from (Head.astro, MarkdownContent.astro, Sidebar.astro).
	for (const nav of document.querySelectorAll<HTMLElement>('[data-lang-switch]:not([data-shared])')) {
		nav.addEventListener('click', (event) => {
			const a = (event.target as Element).closest<HTMLAnchorElement>('[data-lang-choice]');
			if (!a || event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			if (a.hasAttribute('aria-current')) return event.preventDefault();
			try {
				sessionStorage.setItem(
					'tweens-lang-carry',
					JSON.stringify({
						to: a.pathname,
						from: root.dataset.lang,
						at: Date.now(),
						sidebar: document.getElementById('starlight__sidebar')?.scrollTop ?? 0,
						place: place(),
					}),
				);
			} catch {}
		});
	}

	/** The last block both languages share that starts above the line; one language's blocks come and go. */
	const sharedAbove = (line: number) =>
		[...document.querySelectorAll<HTMLElement>('.sl-markdown-content > :not([data-lang-only])')]
			.filter((el) => el.getClientRects().length && top(el) <= line)
			.pop();

	/** Applies a language change without moving what the reader is looking at: the switch they clicked in the page,
	 *  or, from the header or menu, the shared block at the reading line. */
	const steady = (nav: HTMLElement, change: () => void) => {
		const anchor = nav.closest('header, #starlight__sidebar') ? sharedAbove(readingLine()) : nav;
		const before = anchor && top(anchor);
		// The browser's own scroll anchoring can latch onto a block that is about to hide; this takes its place.
		root.style.overflowAnchor = 'none';
		change();
		if (anchor && before !== undefined) {
			const shift = top(anchor) - before;
			if (Math.abs(shift) >= 1) scrollBy({ top: shift, behavior: 'instant' });
		}
		requestAnimationFrame(() => root.style.removeProperty('overflow-anchor'));
	};

	// Shared pages: the choices are toggle buttons for the language of the page's examples.
	for (const nav of document.querySelectorAll<HTMLElement>('[data-lang-switch][data-shared]')) {
		const choices = [...nav.querySelectorAll<HTMLAnchorElement | HTMLButtonElement>('[data-lang-choice]')];
		const sync = () =>
			choices.forEach((a) => a.setAttribute('aria-pressed', String(a.dataset.langChoice === root.dataset.lang)));
		choices.forEach((a) => {
			if (a instanceof HTMLAnchorElement) a.setAttribute('role', 'button');
			a.addEventListener('click', (event) => {
				event.preventDefault();
				if (a.dataset.langChoice === root.dataset.lang) return;
				steady(nav, () => {
					root.dataset.lang = a.dataset.langChoice;
					document.dispatchEvent(new CustomEvent('tweens:lang'));
				});
				try {
					localStorage.setItem(KEY, a.dataset.langChoice!);
				} catch {}
			});
		});
		document.addEventListener('tweens:lang', sync);
		sync();
	}
</script>

<style>
	/* Two equal cells with one indicator that slides to the chosen language. */
	.lang-switch {
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		padding: 3px;
		border: 1px solid var(--tw-outline);
		border-radius: 999px;
		background: var(--tw-stage);
		font: 650 var(--sl-text-xs) var(--sl-font-mono);
		white-space: nowrap;
	}
	.lang-switch::before {
		content: '';
		position: absolute;
		inset: 3px auto 3px 3px;
		width: calc(50% - 3px);
		border-radius: 999px;
		background: var(--tw-mint);
		transition: translate 0.45s var(--ease-back-out);
	}
	:global(:root[data-theme='light']) .lang-switch::before {
		background: var(--tw-mint-ink);
	}
	/* The indicator and the lit label follow data-lang. On arrival from a twin page, data-lang-from holds them on the
	   previous language for the first frame (Head.astro), so the indicator slides over instead of snapping. */
	:global(:root[data-lang='gdscript']) .lang-switch::before,
	:global(:root[data-lang-from='gdscript']) .lang-switch::before {
		translate: 100% 0;
	}
	:global(:root[data-lang-from='csharp']) .lang-switch::before {
		translate: 0 0;
	}
	a {
		position: relative;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		color: var(--tw-muted);
		text-align: center;
		text-decoration: none;
		transition: color 0.2s;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	:global(:root:not([data-lang='gdscript'])) a[data-lang-choice='csharp'],
	:global(:root[data-lang='gdscript']) a[data-lang-choice='gdscript'] {
		color: var(--tw-on-accent);
	}
	:global(:root[data-lang-from]) a[data-lang-choice] {
		color: var(--tw-muted);
	}
	:global(:root[data-lang-from='csharp']) a[data-lang-choice='csharp'],
	:global(:root[data-lang-from='gdscript']) a[data-lang-choice='gdscript'] {
		color: var(--tw-on-accent);
	}
	a:focus-visible {
		outline: 2px solid var(--tw-mint);
		outline-offset: 2px;
	}
	@media (pointer: coarse) {
		a {
			padding-block: 0.55rem;
		}
	}
</style>
