---
// Six coins share one Pop and one Lift definition; each start passes its own copy (C# `with`, GDScript `copy()`).
// The strip under the stage shows the value each coin's copy received; the shared definitions never change.
import type { Lang } from '../scripts/lang';

interface Props {
	lang?: Lang;
}
const { lang = 'csharp' } = Astro.props;
const gd = lang === 'gdscript';
const coins = [100, 80, 92, 70, 86, 104];
---

<div class="tw-widget vs not-content" data-vary-start data-code-lang={lang}>
	<div class="play">
		<div class="stage" style={`--rows: ${coins.length}`}>
			{
				coins.map((y) => (
					<div class="slot" data-slot data-y={y}>
						<span class="ghost" data-ghost style={`top: ${y}px`} />
						<span class="target" data-target style={`top: ${y - 40}px`} />
						<span class="coin" data-coin style={`top: ${y}px`} />
					</div>
				))
			}
		</div>
		<div class="copies">
			<p class="copies-head" data-copies-head>Each coin's copy</p>
			<ol class="values">
				{coins.map(() => <li data-value>—</li>)}
			</ol>
		</div>
	</div>

	<div class="code">
		<div class="pane">
			<p class="pane-label">{gd ? 'The shared definition' : 'The field'}</p>
			{
				gd ? (
					<pre data-field-pop><span class="kw">var</span> pop := Tweens.<span class="fn">scale_2d</span>(<span class="kw">null</span>, <span class="num">0.25</span>)
pop.from_value = Vector2.ZERO
pop.ease = Tweens.Ease.BACK_OUT
<span class="fill" data-fill-line data-on="pop.fill = Tweens.Fill.BOTH" data-off="# fill left at its default">pop.fill = Tweens.Fill.BOTH</span></pre>
				) : (
					<pre data-field-pop><span class="kw">static readonly</span> <span class="ty">Tweens.Scale2D</span> Pop = <span class="kw">new</span>()
{'{'}
    Options = Snappy,
    From = Vector2.Zero,
<span class="fill" data-fill-line data-on="    Fill = FillMode.Both," data-off="    // Fill left at its default">    Fill = FillMode.Both,</span>
{'}'};</pre>
				)
			}
			{
				gd ? (
					<pre data-field-lift hidden><span class="kw">var</span> lift := Tweens.<span class="fn">position_2d_y</span>(<span class="kw">null</span>, <span class="num">0.25</span>)
lift.ease = Tweens.Ease.BACK_OUT</pre>
				) : (
					<pre data-field-lift hidden><span class="kw">static readonly</span> <span class="ty">Tweens.Position2DY</span> Lift =
    <span class="kw">new</span>() {'{'} Options = Snappy {'}'};</pre>
				)
			}
		</div>
		<div class="pane">
			<p class="pane-label">Each start</p>
			{
				gd ? (
					<pre data-call-pop><span class="kw">var</span> start := pop.<span class="fn">copy</span>()
start.delay = i * <span class="num" data-step-out>0.12</span>
Tweens.<span class="fn">play</span>(coins[i], start)</pre>
				) : (
					<pre data-call-pop>coins[i].<span class="fn">Tween</span>(Pop <span class="kw">with</span>
    {'{'} Delay = i * <span class="num" data-step-out>0.12</span> {'}'});</pre>
				)
			}
			{
				gd ? (
					<pre data-call-lift hidden><span class="kw">var</span> up := lift.<span class="fn">copy</span>()
up.to_value = coin.position.y - <span class="num">40</span>
Tweens.<span class="fn">play_all</span>(coin, [up, fade])</pre>
				) : (
					<pre data-call-lift hidden>coin.<span class="fn">Tween</span>(Lift <span class="kw">with</span>
    {'{'} To = Position.Y - <span class="num">40</span> {'}'}, Fade);</pre>
				)
			}
		</div>
	</div>

	<div class="controls">
		<div class="buttons">
			<button type="button" class="tw-btn is-primary" data-appear>Appear</button>
			<button type="button" class="tw-btn" data-collect>Collect</button>
		</div>
		<label class="tw-field step">
			<span>Delay step <output data-step-label>0.12 s</output></span>
			<input type="range" min="0" max="0.3" step="0.02" value="0.12" data-step />
		</label>
		<label class="fill-toggle">
			<input type="checkbox" checked data-fill />
			<code>{gd ? 'fill = Tweens.Fill.BOTH' : 'Fill = FillMode.Both'}</code>
		</label>
	</div>
	<p class="sr-only" aria-live="polite" data-announce></p>
</div>

<script>
	import { EASES, lerp, onceVisible, reducedMotion } from '../scripts/motion';
	import { langOf } from '../scripts/lang';

	// Snappy from the Coin example: 0.25 s, BackOut.
	const DURATION = 0.25;
	const LIFT = 40;

	type Mode = 'rest' | 'appear' | 'collect';

	for (const root of document.querySelectorAll<HTMLElement>('[data-vary-start]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const gd = langOf(root) === 'gdscript';
		const slots = [...root.querySelectorAll<HTMLElement>('[data-slot]')].map((el) => ({
			y: Number(el.dataset.y),
			coin: el.querySelector<HTMLElement>('[data-coin]')!,
			ghost: el.querySelector<HTMLElement>('[data-ghost]')!,
			target: el.querySelector<HTMLElement>('[data-target]')!,
			scale: 1,
			started: false,
		}));
		const values = [...root.querySelectorAll<HTMLElement>('[data-value]')];
		const head = q<HTMLElement>('[data-copies-head]');
		const stepIn = q<HTMLInputElement>('[data-step]');
		const stepLabel = q<HTMLOutputElement>('[data-step-label]');
		const stepOut = q<HTMLElement>('[data-step-out]');
		const fillIn = q<HTMLInputElement>('[data-fill]');
		const fillLine = q<HTMLElement>('[data-fill-line]');
		const appearBtn = q<HTMLButtonElement>('[data-appear]');
		const collectBtn = q<HTMLButtonElement>('[data-collect]');
		const announce = q<HTMLElement>('[data-announce]');
		const panes = {
			pop: [q<HTMLElement>('[data-field-pop]'), q<HTMLElement>('[data-call-pop]')],
			lift: [q<HTMLElement>('[data-field-lift]'), q<HTMLElement>('[data-call-lift]')],
		};

		let mode: Mode = 'rest';
		let startedAt = 0;
		let raf = 0;
		// The copies passed to the last start; the fields themselves stay as declared.
		let delays: number[] = [];

		const step = () => Number(stepIn.value);
		const show = (which: 'pop' | 'lift') => {
			panes.pop.forEach((el) => (el.hidden = which !== 'pop'));
			panes.lift.forEach((el) => (el.hidden = which !== 'lift'));
		};

		const render = (now: number) => {
			const t = (now - startedAt) / 1000;
			let running = false;
			slots.forEach((s, i) => {
				if (mode === 'appear') {
					const local = t - delays[i];
					if (local < 0) {
						// ApplyFromDuringDelay holds From (zero) while waiting; without it the coin keeps its scene scale.
						s.scale = fillIn.checked ? 0 : 1;
						running = true;
					} else {
						const p = Math.min(1, local / DURATION);
						s.scale = EASES.BackOut(p);
						if (p < 1) running = true;
						if (!s.started) {
							s.started = true;
							values[i].classList.add('is-live');
						}
					}
					s.coin.style.scale = String(Math.max(0, s.scale));
					s.coin.style.translate = '0 0';
					s.coin.style.opacity = '1';
				} else if (mode === 'collect') {
					const p = Math.min(1, t / DURATION);
					const w = EASES.BackOut(p);
					if (p < 1) running = true;
					s.coin.style.translate = `0 ${-lerp(0, LIFT, w)}px`;
					s.coin.style.opacity = String(Math.max(0, 1 - w));
				}
			});
			if (running) raf = requestAnimationFrame(render);
			else finish();
		};

		const finish = () => {
			raf = 0;
			collectBtn.disabled = mode === 'collect';
		};

		const run = (next: Mode) => {
			cancelAnimationFrame(raf);
			mode = next;
			root.classList.toggle('is-collected', next === 'collect');
			collectBtn.disabled = true;
			values.forEach((v) => v.classList.remove('is-live'));
			slots.forEach((s) => (s.started = false));
			startedAt = performance.now();
			if (reducedMotion()) {
				// Jump to the settled frame.
				startedAt -= 60_000;
				values.forEach((v) => v.classList.add('is-live'));
			}
			raf = requestAnimationFrame(render);
		};

		const appear = () => {
			delays = slots.map((_, i) => Math.round(i * step() * 100) / 100);
			show('pop');
			head.innerHTML = `Each copy&rsquo;s <code>${gd ? 'delay' : 'Delay'}</code>, in seconds`;
			values.forEach((v, i) => (v.textContent = delays[i].toFixed(2)));
			announce.textContent = `Pop started on six coins with delays from 0 to ${delays.at(-1)!.toFixed(2)} seconds. The shared Pop definition is unchanged.`;
			run('appear');
		};

		const collect = () => {
			show('lift');
			head.innerHTML = gd
				? 'Each copy&rsquo;s <code>to_value</code>, from <code>coin.position.y - 40</code>'
				: 'Each copy&rsquo;s <code>To</code>, from <code>Position.Y - 40</code>';
			values.forEach((v, i) => (v.textContent = String(slots[i].y - LIFT)));
			announce.textContent = `Each coin lifts 40 pixels from its own position, to ${slots.map((s) => s.y - LIFT).join(', ')}.`;
			run('collect');
		};

		appearBtn.addEventListener('click', appear);
		collectBtn.addEventListener('click', collect);
		stepIn.addEventListener('input', () => {
			const v = step().toFixed(2);
			stepLabel.textContent = `${v} s`;
			stepOut.textContent = v;
			show('pop');
		});
		fillIn.addEventListener('change', () => {
			fillLine.classList.toggle('is-off', !fillIn.checked);
			fillLine.textContent = (fillIn.checked ? fillLine.dataset.on : fillLine.dataset.off) ?? '';
			show('pop');
		});

		// Play once when the demo first scrolls into view, so the stagger is visible before any click.
		onceVisible(root, () => !reducedMotion() && mode === 'rest' && appear(), 0.6);
	}
</script>

<style>
	/* minmax(0, …) lets the code scroll inside its pane instead of widening the widget past the page. */
	.vs {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		padding: 1.25rem;
	}

	/* Stage: one column per coin; the copies strip below shares the columns so each value sits under its coin. */
	.play {
		display: grid;
		gap: 0.75rem;
	}
	.stage,
	.values {
		display: grid;
		grid-template-columns: repeat(var(--rows, 6), minmax(0, 1fr));
	}
	.stage {
		position: relative;
		height: 136px;
		border-radius: 0.8rem;
		background:
			linear-gradient(var(--tw-grid) 1px, transparent 1px) 0 0 / 100% 20px,
			var(--tw-surface);
	}
	.slot {
		position: relative;
	}
	.coin,
	.ghost,
	.target {
		position: absolute;
		left: 50%;
		translate: 0 0;
	}
	.coin,
	.ghost {
		width: 28px;
		height: 28px;
		margin: -14px 0 0 -14px;
		border-radius: 50%;
	}
	.coin {
		background: radial-gradient(circle at 35% 30%, #fff8 0 12%, transparent 35%), var(--tw-amber);
		box-shadow: inset 0 0 0 3px color-mix(in oklab, var(--tw-amber) 70%, #000);
	}
	.ghost {
		border: 1.5px dashed var(--tw-track);
		opacity: 0;
		transition: opacity 0.3s;
	}
	/* The computed target: a tick at Position.Y - 40, joined to the start by a dotted rise. */
	.target {
		width: 18px;
		height: 40px;
		margin-left: -9px;
		border-top: 2px solid var(--tw-mint);
		background: linear-gradient(var(--tw-mint) 50%, transparent 0) 50% 0 / 2px 5px repeat-y;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.is-collected :is(.ghost, .target) {
		opacity: 1;
	}

	.copies-head {
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.copies-head :global(code) {
		font-size: 0.95em;
		color: var(--sl-color-white);
	}
	.values {
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 0.3rem;
	}
	.values li {
		margin: 0;
		padding: 0.2rem 0;
		border-radius: 0.4rem;
		background: var(--tw-surface);
		color: var(--tw-muted);
		font: 600 0.72rem var(--sl-font-mono);
		text-align: center;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.values li.is-live {
		background: var(--tw-selected);
		color: var(--sl-color-white);
	}

	/* The two panes sit side by side only where each has room for its longest line. */
	.code {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 0.75rem;
	}
	.pane {
		display: grid;
		grid-template-rows: auto 1fr;
		min-width: 0;
	}
	.pane-label {
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.code pre {
		margin: 0;
		padding: 0.8rem 0.9rem;
		border-radius: 0.7rem;
		background: color-mix(in oklab, var(--tw-bg) 75%, transparent);
		border: 1px solid color-mix(in oklab, var(--tw-outline) 60%, transparent);
		font: 0.76rem/1.7 var(--sl-font-mono);
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.code pre[hidden] {
		display: none;
	}
	.kw {
		color: var(--tw-blue-ink);
	}
	.ty {
		color: var(--tw-mint-ink);
	}
	.fn {
		color: var(--tw-amber-ink);
	}
	.num {
		color: var(--tw-amber-ink);
		font-weight: 700;
	}
	.fill {
		transition: color 0.2s;
	}
	.fill.is-off {
		color: var(--tw-muted);
		font-style: italic;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--tw-outline);
	}
	.buttons {
		display: flex;
		gap: 0.5rem;
	}
	.step {
		flex: 1 1 12rem;
		max-width: 18rem;
	}
	.fill-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		color: var(--tw-soft);
	}
	.fill-toggle input {
		width: 1.1rem;
		height: 1.1rem;
		margin: 0;
	}
	.fill-toggle code {
		font-size: 0.75rem;
		background: none;
		color: inherit;
	}
</style>
