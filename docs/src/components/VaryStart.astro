---
// One shared definition started twice, the second start on a copy with its own duration (the definitions pages).
import type { Lang } from '../scripts/lang';
interface Props { lang?: Lang }
const { lang = 'csharp' } = Astro.props;
const gd = lang === 'gdscript';
---

<div class="tw-widget reuse not-content" data-vary-start data-code-lang={lang}>
	<div class="lanes" aria-label="Two nodes each move 80 pixels right">
		<div class="row">
			<span class="label"><i class="key original"></i>Original <b>0.2 s</b></span>
			<div class="tw-lane" data-lane><span class="tw-lane-mark end" style="--x: 1"></span><span class="tw-sprite"></span></div>
		</div>
		<div class="row">
			<span class="label"><i class="key copy"></i>Copy <b><output data-duration-label>0.6 s</output></b></span>
			<div class="tw-lane" data-lane><span class="tw-lane-mark end" style="--x: 1"></span><span class="tw-sprite"></span></div>
		</div>
	</div>
	<pre class="code tw-code"><code data-start-code></code></pre>
	<div class="controls">
		<button type="button" class="tw-btn is-primary" data-play>Play both</button>
		<label class="tw-field">
			<span>Copy's duration</span>
			<input type="range" min="0.2" max="1.6" step="0.2" value="0.6" data-duration />
		</label>
		<p data-result aria-live="polite">The shared definition stays at 0.2 seconds.</p>
	</div>
</div>

<script>
	import { EASES, reducedMotion } from '../scripts/motion';

	// Hand-highlighted start lines, in the classes theme.css colors.
	const code = (gd: boolean, seconds: string) =>
		gd
			? `Tweens.<span class="fn">play</span>(sprite1, nudge)\nTweens.<span class="fn">play</span>(sprite2, nudge.<span class="fn">with_duration</span>(<span class="num">${seconds}</span>))`
			: `sprite1.<span class="fn">Tween</span>(nudge);\nsprite2.<span class="fn">Tween</span>(nudge <span class="kw">with</span> { Duration = <span class="num">${seconds}</span> });`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-vary-start]')) {
		const lanes = [...root.querySelectorAll<HTMLElement>('[data-lane]')];
		const duration = root.querySelector<HTMLInputElement>('[data-duration]')!;
		const label = root.querySelector<HTMLOutputElement>('[data-duration-label]')!;
		const out = root.querySelector<HTMLElement>('[data-start-code]')!;
		const result = root.querySelector<HTMLElement>('[data-result]')!;
		const gd = root.dataset.codeLang === 'gdscript';
		let frame = 0;
		const show = () => {
			const value = Number(duration.value).toFixed(1);
			label.value = `${value} s`;
			out.innerHTML = code(gd, value);
		};
		show();
		duration.addEventListener('input', () => {
			show();
			result.textContent = 'Ready for the next start. The shared definition stays at 0.2 seconds.';
		});
		root.querySelector('[data-play]')!.addEventListener('click', () => {
			cancelAnimationFrame(frame);
			// Snapshot both durations so changing the slider cannot alter a running tween.
			const durations = [0.2, Number(duration.value)];
			const start = performance.now();
			const reduce = reducedMotion();
			const render = (now: number) => {
				const elapsed = Math.max(0, (now - start) / 1000);
				lanes.forEach((lane, i) => {
					const progress = reduce ? 1 : Math.min(1, elapsed / durations[i]);
					lane.style.setProperty('--x', EASES.CubicOut(progress).toFixed(4));
				});
				if (!reduce && elapsed < Math.max(...durations)) frame = requestAnimationFrame(render);
				else result.textContent = `Both moved 80 pixels. Original: 0.2 s; copy: ${durations[1].toFixed(1)} s.`;
			};
			lanes.forEach((lane) => lane.style.setProperty('--x', '0'));
			result.textContent = 'Playing two independent snapshots.';
			frame = requestAnimationFrame(render);
		});
	}
</script>

<style>
	.reuse {
		display: grid;
		gap: 1rem;
		padding: 1.25rem;
		min-width: 0;
	}
	.lanes {
		display: grid;
		gap: 0.25rem;
	}
	.row {
		display: grid;
		grid-template-columns: 9.5rem minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
	}
	.label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--tw-soft);
		white-space: nowrap;
	}
	.label b {
		font: 600 var(--sl-text-xs) var(--sl-font-mono);
		color: var(--sl-color-white);
	}
	.key {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
	}
	.key.original {
		background: var(--tw-mint);
	}
	.key.copy {
		background: var(--tw-amber);
	}
	.end {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.code {
		margin: 0;
		padding: 0.8rem 1rem;
		min-width: 0;
		overflow-x: auto;
		border-radius: 0.8rem;
		background: color-mix(in oklab, var(--tw-code-inset) 75%, transparent);
		line-height: 1.8;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: center;
	}
	label {
		flex: 0 1 14rem;
	}
	p {
		flex: 1 1 14rem;
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--tw-muted);
	}
	@media (max-width: 30rem) {
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
	}
</style>
