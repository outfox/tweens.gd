---
import type { Lang } from '../scripts/lang';
interface Props { lang?: Lang }
const { lang = 'csharp' } = Astro.props;
const gd = lang === 'gdscript';
---

<div class="tw-widget reuse not-content" data-vary-start data-code-lang={lang}>
	<div class="lanes" aria-label="Two nodes each move 80 pixels right">
		<div class="lane"><span>Original · 0.2 s</span><div class="track"><i data-node /></div></div>
		<div class="lane"><span>Copy · <output data-duration-label>0.6 s</output></span><div class="track"><i data-node /></div></div>
	</div>
	<pre><code data-start-code>{gd
		? 'Tweens.play(first, nudge)\nTweens.play(second, nudge.with_duration(0.6))'
		: 'first.Tween(Nudge);\nsecond.Tween(Nudge with { Duration = 0.6 });'}</code></pre>
	<div class="controls">
		<button type="button" class="tw-btn is-primary" data-play>Play both</button>
		<label class="tw-field">
			<span>Second node's duration</span>
			<input type="range" min="0.2" max="1.6" step="0.2" value="0.6" data-duration />
		</label>
	</div>
	<p data-result aria-live="polite">The shared definition stays at 0.2 seconds.</p>
</div>

<script>
	import { EASES, reducedMotion } from '../scripts/motion';
	for (const root of document.querySelectorAll<HTMLElement>('[data-vary-start]')) {
		const nodes = [...root.querySelectorAll<HTMLElement>('[data-node]')];
		const duration = root.querySelector<HTMLInputElement>('[data-duration]')!;
		const label = root.querySelector<HTMLOutputElement>('[data-duration-label]')!;
		const code = root.querySelector<HTMLElement>('[data-start-code]')!;
		const result = root.querySelector<HTMLElement>('[data-result]')!;
		const gd = root.dataset.codeLang === 'gdscript';
		let frame = 0;
		duration.addEventListener('input', () => {
			const value = Number(duration.value).toFixed(1);
			label.value = `${value} s`;
			code.textContent = gd
				? `Tweens.play(first, nudge)\nTweens.play(second, nudge.with_duration(${value}))`
				: `first.Tween(Nudge);\nsecond.Tween(Nudge with { Duration = ${value} });`;
			result.textContent = 'Ready for the next start. The shared definition stays at 0.2 seconds.';
		});
		root.querySelector('[data-play]')!.addEventListener('click', () => {
			cancelAnimationFrame(frame);
			// Snapshot both durations so changing the slider cannot alter a running tween.
			const durations = [0.2, Number(duration.value)];
			const start = performance.now();
			const reduce = reducedMotion();
			const render = (now: number) => {
				const elapsed = Math.max(0, (now - start) / 1000);
				nodes.forEach((node, i) => {
					const progress = reduce ? 1 : Math.min(1, elapsed / durations[i]);
					node.style.translate = `${80 * EASES.CubicOut(progress)}px 0`;
				});
				if (!reduce && elapsed < Math.max(...durations)) frame = requestAnimationFrame(render);
				else result.textContent = `Both moved 80 pixels. Original: 0.2 s; copy: ${durations[1].toFixed(1)} s.`;
			};
			result.textContent = 'Playing two independent snapshots.';
			render(start);
		});
	}
</script>

<style>
	.reuse { display: grid; gap: 1rem; padding: 1.25rem; min-width: 0; }
	.lanes { display: grid; gap: 0.75rem; }
	.lane { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
	.lane > span { width: 9rem; font-size: var(--sl-text-sm); color: var(--tw-soft); }
	.track { position: relative; width: 112px; height: 36px; border-bottom: 1px dashed var(--tw-track); }
	i { display: block; width: 28px; height: 28px; border-radius: 0.5rem; background: var(--tw-mint); }
	.lane:last-child i { background: var(--tw-amber); }
	pre { margin: 0; padding: 1rem; min-width: 0; overflow-x: auto; border-radius: 0.7rem; background: var(--tw-stage); }
	code { font: 0.8rem/1.7 var(--sl-font-mono); color: var(--sl-color-white); }
	.controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
	label { flex: 1 1 10rem; max-width: 18rem; }
	p { margin: 0; font-size: var(--sl-text-sm); color: var(--tw-soft); }
</style>
