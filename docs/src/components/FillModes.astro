---
// Four copies of one delayed tween, differing only in their fill mode (the loops pages).
import { constant, type Lang } from '../scripts/lang';

interface Props {
	lang?: Lang;
}
const { lang = 'csharp' } = Astro.props;
const modes = [
	{ name: 'RetainFinalValue', delayFrom: false, restore: false },
	{ name: 'ApplyFromDuringDelay', delayFrom: true, restore: true },
	{ name: 'Both', delayFrom: true, restore: false },
	{ name: 'None', delayFrom: false, restore: true },
];
---

<div class="tw-widget fm not-content" data-fill-modes>
	<div class="phases" aria-hidden="true">
		<span class="ph" data-ph="delay">Initial delay</span>
		<span class="ph" data-ph="play">Playing</span>
		<span class="ph" data-ph="done">Natural completion</span>
		<span class="bar"><span class="fill" data-bar></span></span>
	</div>
	<div class="rows">
		{
			modes.map((m) => (
				<div class="row" data-delay-from={String(m.delayFrom)} data-restore={String(m.restore)}>
					<code class="mode">{lang === 'gdscript' ? constant(m.name) : m.name}</code>
					<svg viewBox="0 0 300 40" aria-hidden="true">
						<line class="rail" x1="16" x2="284" y1="20" y2="20" />
						<line class="tick" x1="16" x2="16" y1="10" y2="30" />
						<line class="tick initial" x1="200" x2="200" y1="8" y2="32" />
						<line class="tick" x1="284" x2="284" y1="10" y2="30" />
						<g class="dot" transform="translate(200 20)">
							<circle r="10" />
						</g>
					</svg>
				</div>
			))
		}
	</div>
	<p class="key">
		<span><b class="k-from">From</b> at left</span>
		<span><b class="k-init">captured initial value</b> (dashed)</span>
		<span><b class="k-to">To</b> at right</span>
	</p>
</div>

<script>
	import { EASES, loop } from '../scripts/motion';

	const DELAY = 0.9;
	const LEG = 1.2;
	const AFTER = 1.3;
	const CYCLE = DELAY + LEG + AFTER;
	const FROM = 16;
	const TO = 284;
	const INITIAL = 200;

	for (const root of document.querySelectorAll<HTMLElement>('[data-fill-modes]')) {
		const rows = [...root.querySelectorAll<HTMLElement>('.row')];
		const phases = [...root.querySelectorAll<HTMLElement>('.ph')];
		const bar = root.querySelector<HTMLElement>('[data-bar]')!;
		const dots = rows.map((r) => r.querySelector<SVGGElement>('.dot')!);
		const settle = new Map<SVGGElement, number>();

		loop(
			root,
			(t) => {
				const c = t % CYCLE;
				const phase = c < DELAY ? 'delay' : c < DELAY + LEG ? 'play' : 'done';
				phases.forEach((p) => p.classList.toggle('is-on', p.dataset.ph === phase));
				bar.style.scale = `${c / CYCLE} 1`;

				rows.forEach((row, i) => {
					const delayFrom = row.dataset.delayFrom === 'true';
					const restore = row.dataset.restore === 'true';
					let x: number;
					if (phase === 'delay') x = delayFrom ? FROM : INITIAL;
					else if (phase === 'play') x = FROM + (TO - FROM) * EASES.SmootherStep((c - DELAY) / LEG);
					else x = restore ? INITIAL : TO;

					// Snaps (to From, or back to the initial value) get a short tween so the eye can follow them.
					const dot = dots[i];
					const prev = settle.get(dot) ?? x;
					const jump = Math.abs(x - prev) > 30;
					const shown = jump ? prev + (x - prev) * 0.35 : x;
					settle.set(dot, shown);
					dot.setAttribute('transform', `translate(${shown.toFixed(2)} 20)`);
					row.classList.toggle('is-jump', jump);
				});
			},
			DELAY + LEG + 0.5,
		);
	}
</script>

<style>
	.fm {
		padding: 1.25rem;
		display: grid;
		gap: 1rem;
	}
	.phases {
		position: relative;
		display: grid;
		grid-template-columns: 0.9fr 1.2fr 1.3fr;
		gap: 3px;
		padding-left: 12.5rem;
		padding-bottom: 0.6rem;
		font-size: var(--sl-text-xs);
		text-align: center;
	}
	.ph {
		padding: 0.25rem;
		border-radius: 0.4rem;
		color: var(--tw-muted);
		background: var(--tw-surface);
		transition:
			background-color 0.3s,
			color 0.3s,
			scale 0.4s var(--ease-back-out);
	}
	.ph.is-on {
		background: var(--tw-raised);
		color: var(--sl-color-white);
		scale: 1.04;
	}
	.bar {
		position: absolute;
		left: 12.5rem;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--tw-outline);
	}
	.fill {
		position: absolute;
		inset: 0;
		background: var(--sl-color-white);
		transform-origin: 0 50%;
		scale: 0 1;
	}
	.rows {
		display: grid;
		gap: 0.4rem;
	}
	.row {
		display: grid;
		grid-template-columns: 12rem 1fr;
		gap: 0.5rem;
		align-items: center;
	}
	.mode {
		font-size: 0.75rem;
		color: var(--sl-color-white);
	}
	.row svg {
		width: 100%;
		overflow: visible;
	}
	.rail {
		stroke: var(--tw-outline);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.tick {
		stroke: var(--tw-muted);
		stroke-width: 2;
	}
	.tick.initial {
		stroke: var(--tw-amber);
		stroke-dasharray: 3 3;
	}
	.dot circle {
		fill: var(--tw-mint);
		transition: fill 0.2s;
	}
	.row.is-jump .dot circle {
		fill: var(--tw-amber);
	}
	.key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		justify-content: center;
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.k-from,
	.k-to {
		color: var(--sl-color-white);
	}
	.k-init {
		color: var(--tw-amber-ink);
	}
	@media (max-width: 36rem) {
		.phases {
			padding-left: 0;
		}
		.bar {
			left: 0;
		}
		.row {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
