---
// Four copies of one delayed tween, differing only in their fill mode (the loops pages).
import { constant, type Lang } from '../scripts/lang';

interface Props {
	lang?: Lang;
}
const { lang = 'csharp' } = Astro.props;
const modes = [
	{ name: 'RetainFinalValue', delayFrom: false, restore: false },
	{ name: 'ApplyFromDuringDelay', delayFrom: true, restore: true },
	{ name: 'Both', delayFrom: true, restore: false },
	{ name: 'None', delayFrom: false, restore: true },
];
// Where the property's own value sits between From (0) and To (1); keep in step with the script below.
const INITIAL = 0.69;
---

<div class="tw-widget fm not-content" data-fill-modes>
	<div class="phases" aria-hidden="true">
		<span class="ph" data-ph="delay">Initial delay</span>
		<span class="ph" data-ph="play">Playing</span>
		<span class="ph" data-ph="done">Natural completion</span>
		<span class="bar"><span class="fill" data-bar></span></span>
	</div>
	<div class="rows">
		{
			modes.map((m) => (
				<div class="row" data-delay-from={String(m.delayFrom)} data-restore={String(m.restore)}>
					<code class="mode">{lang === 'gdscript' ? constant(m.name) : m.name}</code>
					<div class="tw-lane" data-lane aria-hidden="true" style={`--x: ${INITIAL}`}>
						<span class="tw-lane-mark" style="--x: 0" />
						<span class="tw-lane-mark initial" style={`--x: ${INITIAL}`} />
						<span class="tw-lane-mark" style="--x: 1" />
						<span class="tw-sprite" />
					</div>
				</div>
			))
		}
	</div>
	<p class="key">
		<span><b class="k-from">From</b> at left</span>
		<span><b class="k-init">captured initial value</b> (dashed)</span>
		<span><b class="k-to">To</b> at right</span>
	</p>
</div>

<script>
	import { EASES, loop } from '../scripts/motion';

	const DELAY = 0.9;
	const LEG = 1.2;
	const AFTER = 1.3;
	const CYCLE = DELAY + LEG + AFTER;
	const INITIAL = 0.69;

	for (const root of document.querySelectorAll<HTMLElement>('[data-fill-modes]')) {
		const rows = [...root.querySelectorAll<HTMLElement>('.row')];
		const phases = [...root.querySelectorAll<HTMLElement>('.ph')];
		const bar = root.querySelector<HTMLElement>('[data-bar]')!;
		const lanes = rows.map((r) => r.querySelector<HTMLElement>('[data-lane]')!);
		const settle = new Map<HTMLElement, number>();

		loop(
			root,
			(t) => {
				const c = t % CYCLE;
				const phase = c < DELAY ? 'delay' : c < DELAY + LEG ? 'play' : 'done';
				phases.forEach((p) => p.classList.toggle('is-on', p.dataset.ph === phase));
				bar.style.scale = `${c / CYCLE} 1`;

				rows.forEach((row, i) => {
					const delayFrom = row.dataset.delayFrom === 'true';
					const restore = row.dataset.restore === 'true';
					let x: number;
					if (phase === 'delay') x = delayFrom ? 0 : INITIAL;
					else if (phase === 'play') x = EASES.SmootherStep((c - DELAY) / LEG);
					else x = restore ? INITIAL : 1;

					// Snaps (to From, or back to the initial value) get a short tween so the eye can follow them.
					const lane = lanes[i];
					const prev = settle.get(lane) ?? x;
					const jump = Math.abs(x - prev) > 0.1;
					const shown = jump ? prev + (x - prev) * 0.35 : x;
					settle.set(lane, shown);
					lane.style.setProperty('--x', shown.toFixed(4));
					row.classList.toggle('is-jump', jump);
				});
			},
			DELAY + LEG + 0.5,
		);
	}
</script>

<style>
	.fm {
		padding: 1.25rem;
		display: grid;
		gap: 0.9rem;
	}
	.phases {
		position: relative;
		display: grid;
		grid-template-columns: 0.9fr 1.2fr 1.3fr;
		gap: 3px;
		padding-left: 12.5rem;
		padding-bottom: 0.6rem;
		font-size: var(--sl-text-xs);
		text-align: center;
	}
	.ph {
		padding: 0.25rem;
		border-radius: 999px;
		color: var(--tw-muted);
		transition:
			background-color 0.3s,
			color 0.3s,
			scale 0.4s var(--ease-back-out);
	}
	.ph.is-on {
		background: var(--tw-raised);
		color: var(--sl-color-white);
		scale: 1.04;
	}
	.bar {
		position: absolute;
		left: 12.5rem;
		right: 0;
		bottom: 0;
		height: 2px;
		border-radius: 1px;
		background: var(--tw-outline);
	}
	.fill {
		position: absolute;
		inset: 0;
		border-radius: 1px;
		background: var(--tw-accent);
		transform-origin: 0 50%;
		scale: 0 1;
	}
	.rows {
		display: grid;
		gap: 0.1rem;
	}
	.row {
		display: grid;
		grid-template-columns: 12rem minmax(0, 1fr);
		gap: 0.5rem;
		align-items: center;
	}
	.mode {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-white);
	}
	.row .tw-lane {
		--sprite: 2rem;
	}
	.tw-lane .initial {
		width: 0;
		height: 1.4rem;
		background: none;
		border-left: 2px dashed var(--tw-amber);
		border-radius: 0;
	}
	.row.is-jump .tw-sprite {
		filter: drop-shadow(0 0 6px color-mix(in oklab, var(--tw-amber) 85%, transparent));
	}
	.key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		justify-content: center;
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.k-from,
	.k-to {
		color: var(--sl-color-white);
	}
	.k-init {
		color: var(--tw-amber-ink);
	}
	@media (max-width: 36rem) {
		.phases {
			padding-left: 0;
		}
		.bar {
			left: 0;
		}
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
	}
</style>
