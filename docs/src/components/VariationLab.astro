---
// The Recoil example from the Variations page, played with the library's InOut.Quad and skew math. Each start is a
// variant of one shared definition: FactorBy and FactorDuration scale it with the damage, Skew and Weks reshape each leg,
// and tuning the definition's own kick moves every variant with it.
import type { Lang } from '../scripts/lang';

interface Props {
	lang?: Lang;
}
const { lang = 'csharp' } = Astro.props;
const gd = lang === 'gdscript';
---

<div class="tw-widget vl not-content" data-variation-lab data-code-lang={lang}>
	<div class="play">
		<div class="stage" aria-hidden="true">
			<span class="rail"></span>
			<span class="mark kick" data-kick-mark><span data-kick-label>24 px</span></span>
			<span class="mark rest"></span>
			<span class="enemy" data-enemy></span>
			<span class="scale" data-scale>Drawn at 3×</span>
		</div>
		<figure class="curve">
			<svg viewBox="0 0 200 120" role="img" aria-label="Eased offset over the outward and return legs of the recoil">
				<path class="grid" d="M0 110 H200 M0 10 H200"></path>
				<path class="base" data-base-curve></path>
				<path class="skewed" data-curve></path>
				<path class="return" data-return-curve></path>
				<circle class="head" r="5" data-head cx="0" cy="110"></circle>
			</svg>
			<figcaption>Offset over time, outward then return: <span class="swatch base"></span> <code>InOut.Quad</code> <span class="swatch skewed"></span> {gd ? 'skew' : 'Skew'} <span class="swatch return"></span> {gd ? 'weks' : 'Weks'}</figcaption>
		</figure>
	</div>

	<div class="code">
		<div class="pane">
			<p class="pane-label">The shared definition</p>
			{
				gd ? (
					<pre class="tw-code"><span class="kw">var</span> recoil := Tweens.<span class="fn">position_2d_x</span>()
recoil.by_value = <span class="num" data-base-by>-12.0</span>
recoil.duration = <span class="num" data-base-duration>0.2</span>
recoil.ease = InOut.QUAD
recoil.ping_pong = <span class="kw">true</span></pre>
				) : (
					<pre class="tw-code"><span class="kw">static readonly</span> <span class="ty">Tweens.Position2DX</span> Recoil = <span class="kw">new</span>()
{'{'}
    By = <span class="num" data-base-by>-12</span>,
    Duration = <span class="num" data-base-duration>0.2</span>,
    Ease = InOut.Quad,
    PingPong = <span class="kw">true</span>,
{'}'};</pre>
				)
			}
		</div>
		<div class="pane">
			<p class="pane-label">This start</p>
			<div class="calls">
				{
					gd ? (
						<pre class="tw-code" data-call-hit>Tweens.<span class="fn">play</span>(self, recoil <span class="cont">\</span>
    .<span class="fn">with_factor_by</span>(<span class="num" data-factor-by>2.0</span>) <span class="cont">\</span>
    .<span class="fn">with_factor_duration</span>(<span class="num" data-factor-duration>1.2</span>) <span class="cont">\</span>
    .<span class="fn">with_skew</span>(<span class="num" data-skew-out>0.5</span>) <span class="cont">\</span>
    .<span class="fn">with_weks</span>(<span class="num" data-weks-out>0.5</span>))</pre>
					) : (
						<pre class="tw-code" data-call-hit><span class="kw">this</span>.<span class="fn">Tween</span>(Recoil <span class="kw">with</span>
{'{'}
    FactorBy = <span class="num" data-factor-by>2</span>,
    FactorDuration = <span class="num" data-factor-duration>1.2</span>,
    Skew = <span class="num" data-skew-out>0.5</span>,
    Weks = <span class="num" data-weks-out>0.5</span>,
{'}'});</pre>
					)
				}
				{
					gd ? (
						<pre class="tw-code" data-call-crit hidden>Tweens.<span class="fn">play</span>(self, recoil <span class="cont">\</span>
    .<span class="fn">with_factor_by</span>(<span class="num" data-crit-by>3.0</span>) <span class="cont">\</span>
    .<span class="fn">with_skew</span>(<span class="num" data-crit-skew>0.25</span>) <span class="cont">\</span>
    .<span class="fn">with_weks</span>(<span class="num" data-crit-weks>0.75</span>))</pre>
					) : (
						<pre class="tw-code" data-call-crit hidden><span class="kw">this</span>.<span class="fn">Tween</span>(Recoil <span class="kw">with</span>
{'{'}
    FactorBy = <span class="num" data-crit-by>3</span>,
    Skew = <span class="num" data-crit-skew>0.25</span>,
    Weks = <span class="num" data-crit-weks>0.75</span>,
{'}'});</pre>
					)
				}
			</div>
			<p class="result" data-result>Kicks 24 px, 0.24 s each way</p>
		</div>
	</div>

	<div class="controls">
		<div class="variant is-active" data-variant="hit">
			<button type="button" class="tw-btn is-primary" data-play>Hit</button>
			<label class="tw-field">
				<span>Damage <output data-out="damage">20</output></span>
				<input type="range" min="0" max="50" step="5" value="20" data-in="damage" />
			</label>
			<label class="tw-field">
				<span>{gd ? 'skew' : 'Skew'} <output data-out="skew">0.50</output></span>
				<input type="range" min="0" max="1" step="0.01" value="0.5" data-in="skew" />
			</label>
			<label class="tw-field">
				<span>{gd ? 'weks' : 'Weks'} <output data-out="weks">0.50</output></span>
				<input type="range" min="0" max="1" step="0.01" value="0.5" data-in="weks" />
			</label>
		</div>
		<div class="variant" data-variant="crit">
			<button type="button" class="tw-btn" data-play>Crit</button>
			<label class="tw-field">
				<span>{gd ? 'factor_by' : 'FactorBy'} <output data-out="factor">3</output></span>
				<input type="range" min="1" max="6" step="0.5" value="3" data-in="factor" />
			</label>
			<label class="tw-field">
				<span>{gd ? 'skew' : 'Skew'} <output data-out="skew">0.25</output></span>
				<input type="range" min="0" max="1" step="0.01" value="0.25" data-in="skew" />
			</label>
			<label class="tw-field">
				<span>{gd ? 'weks' : 'Weks'} <output data-out="weks">0.75</output></span>
				<input type="range" min="0" max="1" step="0.01" value="0.75" data-in="weks" />
			</label>
		</div>
		<div class="shared">
			<label class="tw-field">
				<span>Recoil kick, shared by both <output data-base-label>12 px</output></span>
				<input type="range" min="6" max="20" step="1" value="12" data-base />
			</label>
			<label class="tw-field">
				<span>Recoil duration, shared by both <output data-duration-label>0.2 s</output></span>
				<input type="range" min="0.1" max="0.5" step="0.01" value="0.2" data-duration />
			</label>
			<label class="slow">
				<input type="checkbox" data-slow />
				Slow motion
			</label>
		</div>
	</div>
	<p class="sr-only" aria-live="polite" data-announce></p>
</div>

<script>
	import { composeEase, reducedMotion } from '../scripts/motion';
	import { langOf } from '../scripts/lang';

	const SLOW = 8;
	const W = 200;
	const H = 120;
	const PAD = 10;

	const weight = (progress: number, skew: number) => composeEase('Quad', 'Quad', progress, skew);
	const path = (skew: number, returning = false) => {
		let d = '';
		for (let i = 0; i <= 80; i++) {
			const t = i / 80;
			const progress = returning ? 1 - t : t;
			d += `${i ? 'L' : 'M'}${((t + (returning ? 1 : 0)) * W / 2).toFixed(1)} ${(H - PAD - weight(progress, returning ? 1-skew : skew) * (H - 2 * PAD)).toFixed(1)}`;
		}
		return d;
	};
	const fmt = (n: number, digits: number) => String(Number(n.toFixed(digits)));

	for (const root of document.querySelectorAll<HTMLElement>('[data-variation-lab]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const all = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
		const gd = langOf(root) === 'gdscript';
		const stage = q<HTMLElement>('.stage');
		const scaleNote = q<HTMLElement>('[data-scale]');
		const enemy = q<HTMLElement>('[data-enemy]');
		const kickMark = q<HTMLElement>('[data-kick-mark]');
		const kickLabel = q<HTMLElement>('[data-kick-label]');
		const curve = q<SVGPathElement>('[data-curve]');
		const returnCurve = q<SVGPathElement>('[data-return-curve]');
		const head = q<SVGCircleElement>('[data-head]');
		const baseIn = q<HTMLInputElement>('[data-base]');
		const durationIn = q<HTMLInputElement>('[data-duration]');
		const slowIn = q<HTMLInputElement>('[data-slow]');
		const hitCall = q<HTMLElement>('[data-call-hit]');
		const critCall = q<HTMLElement>('[data-call-crit]');
		const result = q<HTMLElement>('[data-result]');
		const announce = q<HTMLElement>('[data-announce]');
		q<SVGPathElement>('[data-base-curve]').setAttribute('d', path(.5) + ' ' + path(.5, true));

		// One row per variant, each with its own button and sliders.
		type Name = 'hit' | 'crit';
		const names: Name[] = ['hit', 'crit'];
		const row = (name: Name) => {
			const el = q<HTMLElement>(`[data-variant="${name}"]`);
			const input = (key: string) => el.querySelector<HTMLInputElement>(`[data-in="${key}"]`)!;
			const output = (key: string) => el.querySelector<HTMLOutputElement>(`[data-out="${key}"]`)!;
			return { el, button: el.querySelector<HTMLButtonElement>('[data-play]')!, input, output };
		};
		const rows = { hit: row('hit'), crit: row('crit') };
		// The variant the curve, marker, and code show: the row last played or adjusted.
		let active: Name = 'hit';
		let raf = 0;

		// Each row's variant, computed as the library does at start: factor × value + delta.
		const variant = (name: Name) => {
			const base = -Number(baseIn.value);
			const skew = Number(rows[name].input('skew').value);
			const weks = Number(rows[name].input('weks').value);
			const damage = Number(rows.hit.input('damage').value);
			const factorBy = name === 'hit' ? damage / 10 : Number(rows.crit.input('factor').value);
			const factorDuration = name === 'hit' ? 1 + damage / 100 : 1;
			return { base, damage, factorBy, factorDuration, skew, weks, by: factorBy * base, duration: factorDuration * Number(durationIn.value) };
		};

		// Real kicks are a few dozen pixels, so the stage draws them larger: up to 3×, as far as the widest kick fits.
		const zoom = () => Math.max(1, Math.min(3, (stage.clientWidth - 96) / 100));

		const place = (offset: number, progress: number, skew: number, returning = false) => {
			enemy.style.translate = `${offset * zoom()}px 0`;
			head.setAttribute('cx', ((returning ? 2 - progress : progress) * W / 2).toFixed(1));
			head.setAttribute('cy', (H - PAD - weight(progress, returning ? 1-skew : skew) * (H - 2 * PAD)).toFixed(1));
		};

		const sync = () => {
			const hit = variant('hit');
			const crit = variant('crit');
			const v = active === 'hit' ? hit : crit;
			rows.hit.output('damage').textContent = String(hit.damage);
			rows.hit.output('skew').textContent = hit.skew.toFixed(2);
			rows.hit.output('weks').textContent = hit.weks.toFixed(2);
			rows.crit.output('factor').textContent = fmt(crit.factorBy, 1);
			rows.crit.output('skew').textContent = crit.skew.toFixed(2);
			rows.crit.output('weks').textContent = crit.weks.toFixed(2);
			q<HTMLOutputElement>('[data-base-label]').textContent = `${baseIn.value} px`;
			q<HTMLOutputElement>('[data-duration-label]').textContent = `${durationIn.value} s`;
			all('[data-base-duration]').forEach((el) => (el.textContent = durationIn.value));
			const number = (n: number, digits: number) => (gd ? n.toFixed(digits) : fmt(n, digits));
			all('[data-base-by]').forEach((el) => (el.textContent = gd ? v.base.toFixed(1) : String(v.base)));
			all('[data-factor-by]').forEach((el) => (el.textContent = number(hit.factorBy, 1)));
			all('[data-factor-duration]').forEach((el) => (el.textContent = fmt(hit.factorDuration, 2)));
			all('[data-skew-out]').forEach((el) => (el.textContent = number(hit.skew, 2)));
			all('[data-weks-out]').forEach((el) => (el.textContent = number(hit.weks, 2)));
			all('[data-crit-by]').forEach((el) => (el.textContent = number(crit.factorBy, 1)));
			all('[data-crit-skew]').forEach((el) => (el.textContent = number(crit.skew, 2)));
			all('[data-crit-weks]').forEach((el) => (el.textContent = number(crit.weks, 2)));
			hitCall.hidden = active !== 'hit';
			critCall.hidden = active !== 'crit';
			for (const name of names) {
				rows[name].el.classList.toggle('is-active', name === active);
				rows[name].button.classList.toggle('is-primary', name === active);
			}
			curve.setAttribute('d', path(v.skew));
			returnCurve.setAttribute('d', path(v.weks, true));
			const z = zoom();
			kickMark.style.setProperty('--kick', `${v.by * z}px`);
			scaleNote.textContent = `Drawn at ${fmt(z, 1)}×`;
			kickLabel.textContent = `${fmt(Math.abs(v.by), 1)} px`;
			const label = active === 'hit' ? 'Hit' : 'Crit';
			result.textContent = `${label}: kicks ${fmt(Math.abs(v.by), 1)} px, ${fmt(v.duration, 3)} s each way`;
			return v;
		};

		const play = (name: Name) => {
			active = name;
			cancelAnimationFrame(raf);
			const v = sync();
			const what = name === 'hit' ? `Hit for ${v.damage} damage` : 'Crit';
			announce.textContent = `${what}: kicks ${fmt(Math.abs(v.by), 1)} pixels, ${fmt(v.duration, 3)} seconds each way, skew ${fmt(v.skew, 2)}, weks ${fmt(v.weks, 2)}.`;
			if (reducedMotion()) {
				place(v.by, 1, v.skew);
				return;
			}
			const leg = v.duration * (slowIn.checked ? SLOW : 1) * 1000;
			const start = performance.now();
			const frame = (now: number) => {
				// Ping-pong: each leg uses its own In/Out split.
				const t = (now - start) / leg;
				const returning = t > 1;
				const progress = Math.max(0, returning ? 2 - t : t);
				const split = returning ? v.weks : v.skew;
				place(v.by * weight(progress, returning ? 1-split : split), progress, split, returning);
				if (t < 2) raf = requestAnimationFrame(frame);
				else place(0, 0, v.weks, true);
			};
			raf = requestAnimationFrame(frame);
		};

		for (const name of names) {
			rows[name].button.addEventListener('click', () => play(name));
			for (const input of rows[name].el.querySelectorAll('input'))
				input.addEventListener('input', () => {
					active = name;
					sync();
				});
		}
		baseIn.addEventListener('input', () => sync());
		durationIn.addEventListener('input', () => sync());
		new ResizeObserver(() => sync()).observe(stage);
	}
</script>

<style>
	.vl {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		padding: 1.25rem;
	}
	.play {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 0.75rem;
	}

	/* Stage: the enemy rests at the right; the dashed mark shows where this start's kick reaches. */
	.stage {
		position: relative;
		min-height: 9rem;
		border-radius: 0.8rem;
		background:
			linear-gradient(90deg, var(--tw-grid) 1px, transparent 1px) 0 0 / 36px 100%,
			var(--tw-surface);
		overflow: hidden;
	}
	.scale {
		position: absolute;
		left: 0.75rem;
		bottom: 0.6rem;
		font-size: var(--sl-text-2xs);
		color: var(--tw-muted);
	}
	.rail {
		position: absolute;
		inset-inline: 1rem;
		top: calc(50% + 1.4rem);
		height: 2px;
		border-radius: 1px;
		background: var(--tw-outline);
	}
	.enemy,
	.mark {
		position: absolute;
		top: 50%;
		right: 3rem;
	}
	.enemy {
		width: 2.4rem;
		height: 2.4rem;
		margin: -1.2rem -1.2rem 0 0;
		border-radius: 0.7rem;
		background: radial-gradient(circle at 32% 28%, #fff6 0 14%, transparent 36%), var(--tw-rose);
		box-shadow: inset 0 0 0 3px color-mix(in oklab, var(--tw-rose) 65%, #000);
	}
	.mark {
		height: 3.4rem;
		margin-top: -1.7rem;
		border-left: 2px dashed var(--tw-track);
	}
	.rest {
		opacity: 0.6;
	}
	.kick {
		translate: var(--kick, 0) 0;
		border-left-color: var(--tw-mint);
		transition: translate 0.45s var(--ease-back-out);
	}
	.kick span {
		position: absolute;
		top: -1.5rem;
		left: 0;
		translate: -50% 0;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: var(--tw-selected);
		color: var(--sl-color-white);
		font: 600 0.7rem var(--sl-font-mono);
		white-space: nowrap;
	}

	/* Curve: normalized time left to right, eased offset bottom to top. */
	.curve {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding: 0.75rem;
		border-radius: 0.8rem;
		background: var(--tw-surface);
	}
	.curve svg {
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.grid {
		stroke: var(--tw-grid);
		stroke-width: 1;
		fill: none;
	}
	.base,
	.skewed,
	.return {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.base {
		stroke: var(--tw-outline);
		stroke-dasharray: 4 5;
	}
	.skewed {
		stroke: var(--tw-mint);
	}
	.return {
		stroke: var(--tw-amber);
	}
	.swatch.return {
		border-color: var(--tw-amber);
	}
	.head {
		fill: var(--tw-bg);
		stroke: var(--tw-mint);
		stroke-width: 2.5;
	}
	.curve figcaption {
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.curve figcaption code {
		font-size: 0.95em;
		background: none;
		color: var(--tw-soft);
	}
	.swatch {
		display: inline-block;
		width: 1.1rem;
		height: 0;
		margin-left: 0.4rem;
		vertical-align: middle;
		border-top: 2.5px solid var(--tw-mint);
	}
	.swatch.base {
		border-top: 2.5px dashed var(--tw-outline);
	}

	.code {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 0.75rem;
	}
	.pane {
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-width: 0;
	}
	.pane-label,
	.result {
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-xs);
		color: var(--tw-muted);
	}
	.result {
		margin: 0.5rem 0 0;
		color: var(--tw-soft);
		font-weight: 600;
	}
	.code pre {
		margin: 0;
		padding: 0.8rem 0.9rem;
		border-radius: 0.7rem;
		background: color-mix(in oklab, var(--tw-code-inset) 75%, transparent);
		border: 1px solid color-mix(in oklab, var(--tw-outline) 60%, transparent);
		line-height: 1.7;
		overflow-x: auto;
	}
	/* Both starts share one cell, so the box keeps the taller one's height and nothing below shifts on switching. */
	.calls {
		display: grid;
	}
	.calls > pre {
		grid-area: 1 / 1;
	}
	.calls > pre[hidden] {
		display: block;
		visibility: hidden;
	}
	.num {
		font-weight: 700;
	}
	/* GDScript needs the line continuations, but they carry no meaning worth reading. */
	.cont {
		color: var(--tw-muted);
		opacity: 0.6;
	}

	/* One row per variant, then the shared settings. The active row, the one the curve and code show, is tinted. */
	.controls {
		display: grid;
		gap: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--tw-outline);
	}
	.variant,
	.shared {
		display: grid;
		grid-template-columns: 5.5rem repeat(3, minmax(0, 1fr));
		align-items: end;
		gap: 0.75rem 1.25rem;
		padding: 0.6rem 0.75rem;
		border-radius: 0.8rem;
		transition: background-color 0.25s;
	}
	.variant.is-active {
		background: color-mix(in oklab, var(--tw-accent) 9%, transparent);
	}
	.variant .tw-btn {
		justify-content: center;
	}
	.shared {
		grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
		padding-top: 0.9rem;
	}
	@media (max-width: 44rem) {
		:is(.variant, .shared) {
			grid-template-columns: minmax(0, 1fr);
		}
		.variant .tw-btn {
			justify-self: start;
		}
	}
	.slow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.25rem;
		cursor: pointer;
		color: var(--tw-soft);
		white-space: nowrap;
	}
	.slow input {
		width: 1.1rem;
		height: 1.1rem;
		margin: 0;
	}
</style>
